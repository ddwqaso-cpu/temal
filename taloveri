local function Toast(msg, duration)
    -- Interface Hidden / toast notification
    local sg = Instance.new("ScreenGui")
    sg.Name = "PhantomToast"
    sg.IgnoreGuiInset = true
    sg.ResetOnSpawn = false
    pcall(function() sg.Parent = Services.CoreGui end)
    if not sg.Parent then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 70)
    frame.Position = UDim2.new(0.5, -150, 1, -120)
    frame.BackgroundColor3 = Color3.fromRGB(28,28,34)
    frame.BorderSizePixel = 0
    frame.Parent = sg
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(140,90,220)
    stroke.Thickness = 1
    stroke.Transparency = 0.4
    stroke.Parent = frame

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 32, 0, 32)
    icon.Position = UDim2.new(0, 16, 0.5, -16)
    icon.BackgroundTransparency = 1
    icon.Image = "rbxassetid://10723407367"  -- cloud/check icon
    icon.ImageColor3 = Color3.fromRGB(140,90,220)
    icon.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -60, 0, 22)
    title.Position = UDim2.new(0, 60, 0, 14)
    title.BackgroundTransparency = 1
    title.Text = "Interface Hidden"
    title.TextColor3 = Color3.fromRGB(255,255,255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, -60, 0, 18)
