PHANTOM.Aimbot = {
    FOV = 120,
    Smoothness = 0.15,
    Prediction = 0.135,
    TeamCheck = true,
    WallCheck = false,
    TargetPart = "HumanoidRootPart",
    SilentAimPart = "Head",
    StickyTarget = nil,
    StickyTime = 0,

    GetClosestPlayer = function(self, useScreenSpace)
        local closestPlayer, closestDistance = nil, self.FOV
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

        local cameraPos = Camera.CFrame.Position
        local mousePos = Services.UserInputService:GetMouseLocation()

        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player == LocalPlayer or not player.Character then continue end
            local targetPart = player.Character:FindFirstChild(self.TargetPart)
            if not targetPart then continue end
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            if self.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end

            if self.WallCheck then
                local ray = Ray.new(cameraPos, (targetPart.Position - cameraPos).Unit * 1000)
                local hit = Services.Workspace:FindPartOnRay(ray, myChar)
                if hit and not hit:IsDescendantOf(player.Character) then continue end
            end

            local distance
            if useScreenSpace then
                local sp, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if not onScreen then continue end
                distance = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
            else
                distance = (targetPart.Position - cameraPos).Magnitude
            end

            if distance < closestDistance then
                closestDistance = distance
                closestPlayer = player
            end
        end
        return closestPlayer
    end,

    CalculatePrediction = function(self, part)
        if not part or not part.Parent then return Vector3.new() end
        local v = part.AssemblyLinearVelocity or part.Velocity or Vector3.new()
        return part.Position + (v * self.Prediction)
    end,

    GetSilentTarget = function(self)
        return self:GetClosestPlayer(true)
    end,

    RunVectorAim = function(self)
        if not PHANTOM.Runtime.VectorAimActive then return end
        local target = self:GetClosestPlayer(false)
        if not target or not target.Character then return end
        local tp = target.Character:FindFirstChild(self.TargetPart)
        if not tp then return end
        local predicted = self:CalculatePrediction(tp)
        local cameraPos = Camera.CFrame.Position
        local look = CFrame.lookAt(cameraPos, predicted)
        Camera.CFrame = Camera.CFrame:Lerp(look, self.Smoothness)
    end,

    DrawFOV = function(self)
        if not PHANTOM.Visuals.FOVCircle then
            local c = Drawing.new("Circle")
            c.Thickness = 1
            c.NumSides = 64
            c.Filled = false
            c.Color = Color3.fromRGB(140, 90, 220)
            c.Transparency = 0.85
            PHANTOM.Visuals.FOVCircle = c
        end
        local c = PHANTOM.Visuals.FOVCircle
        c.Visible = PHANTOM.Config.ShowFOV
        if c.Visible then
            c.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            c.Radius = self.FOV
        end
    end
}

