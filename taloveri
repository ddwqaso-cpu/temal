PHANTOM.Keybinds = {
    registry = {},
    held = {},
    
    Register = function(self, name, defaultKey, callback)
        local bind = {
            Name = name,
            Key = defaultKey,
            Callback = callback,
            Active = false
        }
        self.registry[name] = bind
        return bind
    end,
    
    SetKey = function(self, name, keyCode)
        if self.registry[name] then
            self.registry[name].Key = keyCode
        end
    end,
    
    IsHeld = function(self, name)
        local bind = self.registry[name]
        if not bind then return false end
        return Services.UserInputService:IsKeyDown(bind.Key)
    end,
    
    Initialize = function(self)
        Services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            
            for _, bind in pairs(self.registry) do
                if input.KeyCode == bind.Key then
                    bind.Active = not bind.Active
                    if bind.Callback then
                        pcall(bind.Callback, bind.Active)
                    end
                end
            end
        end)
    end
}

