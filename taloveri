PHANTOM.Aimbot = {
    --// Configuration defaults
    FOV = 120,
    Smoothness = 0.15,
    Prediction = 0.135,
    TeamCheck = true,
    WallCheck = false,
    TargetPart = "HumanoidRootPart",
    SilentAimPart = "Head",
    
    --// Gets the closest valid player within FOV
    GetClosestPlayer = function(self, useScreenSpace)
        local closestPlayer = nil
        local closestDistance = self.FOV
        
        local myCharacter = LocalPlayer.Character
        if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then
            return nil
        end
        
        local cameraPos = Camera.CFrame.Position
        local mousePos = Services.UserInputService:GetMouseLocation()
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if not player.Character then continue end
            
            local targetPart = player.Character:FindFirstChild(self.TargetPart)
            if not targetPart then continue end
            
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            
            --// Team check
            if self.TeamCheck and player.Team == LocalPlayer.Team then continue end
            
            --// Visibility check
            if self.WallCheck then
                local ray = Ray.new(cameraPos, (targetPart.Position - cameraPos).Unit * 1000)
                local hit = Services.Workspace:FindPartOnRay(ray, myCharacter)
                if hit and not hit:IsDescendantOf(player.Character) then continue end
            end
            
            --// Distance calculation
            local distance
            if useScreenSpace then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if not onScreen then continue end
                distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
            else
                distance = (targetPart.Position - cameraPos).Magnitude
            end
            
            if distance < closestDistance then
                closestDistance = distance
                closestPlayer = player
            end
        end
        
        return closestPlayer
    end,
    
    --// Prediction calculation for moving targets
    CalculatePrediction = function(self, part)
        if not part or not part.Parent then return part.Position end
        
        local velocity = part.Velocity or part.AssemblyLinearVelocity
        return part.Position + (velocity * self.Prediction)
    end,
    
    --// Gets silent aim target (screen-space based)
    GetSilentTarget = function(self)
        return self:GetClosestPlayer(true)
    end,
    
    --// Vector Aim — camera interpolation loop
    RunVectorAim = function(self)
        if not self.VectorAimActive then return end
        
        local target = self:GetClosestPlayer(false)
        if not target or not target.Character then return end
        
        local targetPart = target.Character:FindFirstChild(self.TargetPart)
        if not targetPart then return end
        
        local predictedPos = self:CalculatePrediction(targetPart)
        local cameraPos = Camera.CFrame.Position
        
        local lookCFrame = CFrame.lookAt(cameraPos, predictedPos)
        local newCFrame = Camera.CFrame:Lerp(lookCFrame, self.Smoothness)
        
        Camera.CFrame = newCFrame
    end,
    
    --// Silent Aim — processed through namecall hook
    RunSilentAim = function(self)
        --// Handled by InstallNameCallHook()
    end,
    
    --// FOV visualization
    DrawFOV = function(self)
        if not PHANTOM.Visuals.FOVCircle then
            local circle = Drawing.new("Circle")
            circle.Thickness = 1
            circle.NumSides = 64
            circle.Radius = self.FOV
            circle.Filled = false
            circle.Color = Color3.fromRGB(255, 255, 255)
            circle.Transparency = 0.8
            PHANTOM.Visuals.FOVCircle = circle
        end
        
        local circle = PHANTOM.Visuals.FOVCircle
        circle.Visible = PHANTOM.Config.ShowFOV
        if not circle.Visible then return end
        
        circle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        circle.Radius = self.FOV
    end
}

