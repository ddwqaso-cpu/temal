        default and PHANTOM.Config.AccentColor or Color3.fromRGB(80, 80, 90), 1, 0)

    local check = UI.New("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "✓",
        TextColor3 = Color3.fromRGB(255, 255, 255),
