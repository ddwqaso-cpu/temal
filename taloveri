PHANTOM.Visuals._LightingOriginal = {
    Brightness = Services.Lighting.Brightness,
    ClockTime = Services.Lighting.ClockTime,
    GlobalShadows = Services.Lighting.GlobalShadows,
    FogEnd = Services.Lighting.FogEnd,
    FogStart = Services.Lighting.FogStart,
    Ambient = Services.Lighting.Ambient,
    OutdoorAmbient = Services.Lighting.OutdoorAmbient
}

PHANTOM.Visuals.ApplyLighting = function(self)
    local L = Services.Lighting
    local S = self.Slots

    -- FullBright
    if S.FullBright.enabled then
        L.Brightness = 3
        L.ClockTime = 14
        L.GlobalShadows = false
        L.FogEnd = 1e6
        L.FogStart = 1e6
    elseif S.ResetLighting.enabled then
        L.Brightness = self._LightingOriginal.Brightness
        L.ClockTime = self._LightingOriginal.ClockTime
        L.GlobalShadows = self._LightingOriginal.GlobalShadows
        L.FogEnd = self._LightingOriginal.FogEnd
        L.FogStart = self._LightingOriginal.FogStart
        S.ResetLighting.enabled = false
    end

    -- NoFog
    if S.NoFog.enabled then
        L.FogEnd = 1e6
        L.FogStart = 1e6
    end

    -- Ambient
    if S.AmbientLight.enabled then L.Ambient = S.AmbientLight.color end
    if S.OutdoorAmbient.enabled then L.OutdoorAmbient = S.OutdoorAmbient.color end

    -- ClockTime
    if S.ClockTime.enabled then L.ClockTime = S.ClockTime.value end

    -- NoParticles
    if S.NoParticles.enabled then
        for _, obj in ipairs(Services.Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end
    end

    -- NoGrass
    if S.NoGrass.enabled then
        pcall(function()
            Services.Workspace.Terrain.Decoration = false
        end)
    end

    -- Skybox reset to default
    if S.Skybox.enabled then
        pcall(function()
            local sky = Services.Lighting:FindFirstChildOfClass("Sky")
            if sky then sky:Destroy() end
        end)
    end

    -- ColorCorrection / Bloom
    if S.ColorCorrection.enabled then
        local existing = Services.Lighting:FindFirstChild("PhantomCC")
        if not existing then
            local cc = Instance.new("ColorCorrectionEffect")
            cc.Name = "PhantomCC"
            cc.Brightness = 0.05
            cc.Contrast = 0.1
            cc.Saturation = 0.15
            cc.Parent = Services.Lighting
        end
    else
        local existing = Services.Lighting:FindFirstChild("PhantomCC")
        if existing then existing:Destroy() end
    end

    if S.BloomEffect.enabled then
        local existing = Services.Lighting:FindFirstChild("PhantomBloom")
        if not existing then
            local b = Instance.new("BloomEffect")
            b.Name = "PhantomBloom"
            b.Intensity = 1
            b.Size = 24
            b.Threshold = 0.8
            b.Parent = Services.Lighting
        end
    else
        local existing = Services.Lighting:FindFirstChild("PhantomBloom")
        if existing then existing:Destroy() end
    end

    -- ForceField (визуальный)
    if S.ForceField.enabled and LocalPlayer.Character then
        for _, obj in ipairs(LocalPlayer.Character:GetChildren()) do
            if obj:IsA("ForceField") then
                obj.Visible = true
                obj.Color = S.FFColor.color
            end
        end
    end
end

