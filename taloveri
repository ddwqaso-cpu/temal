        end
        if C.Moonlight then
            Lighting.ClockTime=0
            Lighting.Brightness=1
            Lighting.Ambient=Color3.fromRGB(40,50,80)
        end
        if C.StarField then
            Lighting.ClockTime=0
        end
        if C.SlowMotion then
            Lighting.ClockTime=Lighting.ClockTime
        end
    end
end)

-- ========== AURORA (ColorCorrection) ==========
local auroraCC=nil
task.spawn(function()
    while task.wait(0.1) do
        if C.Aurora then
            if not auroraCC then
                auroraCC=Instance.new("ColorCorrectionEffect")
                auroraCC.Name="PhantomAurora"
                auroraCC.Parent=Lighting
            end
            local t=tick()
            local r=(math.sin(t*0.5)+1)/2
            auroraCC.TintColor=C.AuroraColor1:Lerp(C.AuroraColor2,r)
            auroraCC.Saturation=0.3
            auroraCC.Brightness=0.05
        else
            if auroraCC then auroraCC:Destroy() auroraCC=nil end
        end
    end
end)

