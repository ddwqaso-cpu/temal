                local cc=Instance.new("ColorCorrectionEffect")
                cc.Name="PhantomTint"
                cc.Parent=Lighting
                return cc
            end)()
            Lighting.PhantomTint.TintColor=C.BlueTintColor
            Lighting.PhantomTint.Saturation=-0.1
        else
