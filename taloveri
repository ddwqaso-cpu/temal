    -- =========================================================
    -- UPDATE (вызывается каждый кадр)
    -- =========================================================
    Update = function(self)
        local char, hum, root = U.GetLocalCharacter()

        -- TriggerBot — стреляем по игроку под прицелом
        if self.Features.TriggerBot.enabled and tick() - self.Features.TriggerBot.lastFire > self.Features.TriggerBot.delay then
            local target = PHANTOM.Aimbot:GetClosestPlayer(true)
            if target then
                local mouse = Services.UserInputService:GetMouseLocation()
                pcall(function()
                    if mousemoverel then
                        mousemoverel(0, 0)
                    end
                    if mouse1click then mouse1click() end
                end)
                self.Features.TriggerBot.lastFire = tick()
            end
        end

        -- AutoHeal
        if self.Features.AutoHeal.enabled and hum and tick() - self.Features.AutoHeal.lastHeal > 0.5 then
            if hum.Health < self.Features.AutoHeal.threshold then
                pcall(function()
                    if VirtualInputManager then
                        -- Симуляция нажатия клавиши лечения
                    end
                end)
                self.Features.AutoHeal.lastHeal = tick()
            end
        end

        -- HitboxExpander — увеличиваем размеры HumanoidRootPart у всех игроков
        if self.Features.HitboxExpander.enabled then
            for _, player in ipairs(Services.Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local c = player.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if r then
                    if not self.Features.HitboxExpander.originalSizes[player] then
                        self.Features.HitboxExpander.originalSizes[player] = r.Size
                    end
                    r.Size = Vector3.new(
                        self.Features.HitboxExpander.size,
                        self.Features.HitboxExpander.size,
                        self.Features.HitboxExpander.size
                    )
                    r.Transparency = 0.7
                    r.CanCollide = false
                end
            end
        else
            -- Восстановить
            for player, size in pairs(self.Features.HitboxExpander.originalSizes) do
                if player and player.Parent then
                    local c = player.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    if r then
                        r.Size = size
                        r.Transparency = 1
                    end
                end
            end
        end

        -- KillAura
        if self.Features.KillAura.enabled and tick() - self.Features.KillAura.lastHit > self.Features.KillAura.speed then
            for _, player in ipairs(Services.Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local c, h, r = U.GetCharacter(player)
                if c and r and root then
                    local d = (r.Position - root.Position).Magnitude
                    if d <= self.Features.KillAura.range then
                        pcall(function()
                            -- Симуляция атаки через tool
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then
                                tool:Activate()
                            end
                        end)
                        self.Features.KillAura.lastHit = tick()
                        break
                    end
                end
            end
        end

        -- AutoVoid return
        if self.Features.AntiFlinch.enabled and hum then
            hum.PlatformStand = false
        end

        -- Sticky aim expire
        if self.Features.StickyAim.enabled then
            if self.Features.StickyAim.target and U.IsAlive(self.Features.StickyAim.target) then
                PHANTOM.Aimbot.StickyTarget = self.Features.StickyAim.target
                PHANTOM.Aimbot.StickyExpire = tick() + self.Features.StickyAim.lockTime
            end
        end
    end
}

