PHANTOM.Visuals.EnsureScreen = function(self)
    local S = self._ScreenState

    if not S.Crosshair.L1 then
        for i = 1, 4 do
            local l = Drawing.new("Line")
            l.Thickness = 1
            l.Color = PHANTOM.Visuals.Slots.CrosshairColor.color
            l.Visible = false
            S.Crosshair["L" .. i] = l
        end
    end

    if not S.Hitmarker.L1 then
        for i = 1, 4 do
            local l = Drawing.new("Line")
            l.Thickness = 2
            l.Color = Color3.fromRGB(255,80,80)
            l.Visible = false
            S.Hitmarker["L" .. i] = l
        end
    end

    if not S.Vignette then
        local f = Instance.new("Frame")
        f.Name = "PhantomVignette"
        f.Size = UDim2.new(1, 0, 1, 0)
        f.BackgroundColor3 = Color3.fromRGB(0,0,0)
        f.BackgroundTransparency = 1
        f.BorderSizePixel = 0
        f.ZIndex = 5
        f.Parent = PHANTOM.UI.ScreenGui
        local grad = Instance.new("UIGradient")
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.3),
            NumberSequenceKeypoint.new(0.5, 1),
            NumberSequenceKeypoint.new(1, 0.3)
        })
        grad.Rotation = 90
        grad.Parent = f
        S.Vignette = f
    end

    if not S.BarsTop then
        local t = Instance.new("Frame")
        t.Name = "PhantomBarsTop"
        t.Size = UDim2.new(1, 0, 0.1, 0)
        t.BackgroundColor3 = Color3.fromRGB(0,0,0)
        t.BorderSizePixel = 0
        t.ZIndex = 6
        t.Visible = false
        t.Parent = PHANTOM.UI.ScreenGui
        S.BarsTop = t

        local b = Instance.new("Frame")
        b.Name = "PhantomBarsBottom"
        b.Size = UDim2.new(1, 0, 0.1, 0)
        b.Position = UDim2.new(0, 0, 0.9, 0)
        b.BackgroundColor3 = Color3.fromRGB(0,0,0)
        b.BorderSizePixel = 0
        b.ZIndex = 6
        b.Visible = false
        b.Parent = PHANTOM.UI.ScreenGui
        S.BarsBottom = b
    end

    if not S.Damage then
        local d = Instance.new("Frame")
        d.Name = "PhantomDamage"
        d.Size = UDim2.new(1, 0, 1, 0)
        d.BackgroundColor3 = Color3.fromRGB(255,0,0)
        d.BackgroundTransparency = 1
        d.BorderSizePixel = 0
        d.ZIndex = 4
        d.Parent = PHANTOM.UI.ScreenGui
        S.Damage = d
    end
end

PHANTOM.Visuals.UpdateScreen = function(self)
    self:EnsureScreen()
    local S = self._ScreenState
    local Slots = self.Slots
    local vp = Camera.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2

    -- Crosshair
    local onCH = Slots.Crosshair.enabled
    for _, l in pairs(S.Crosshair) do l.Visible = onCH end
    if onCH then
        local sz = Slots.CrosshairSize.value
        local col = Slots.CrosshairColor.color
        S.Crosshair.L1.From = Vector2.new(cx, cy - sz)
        S.Crosshair.L1.To   = Vector2.new(cx, cy - 3)
        S.Crosshair.L2.From = Vector2.new(cx, cy + 3)
        S.Crosshair.L2.To   = Vector2.new(cx, cy + sz)
        S.Crosshair.L3.From = Vector2.new(cx - sz, cy)
        S.Crosshair.L3.To   = Vector2.new(cx - 3, cy)
        S.Crosshair.L4.From = Vector2.new(cx + 3, cy)
        S.Crosshair.L4.To   = Vector2.new(cx + sz, cy)
        for _, l in pairs(S.Crosshair) do l.Color = col end
    end

    -- Hitmarker (только если недавно вызван)
    if tick() < S.Hitmarker.Expire then
        local sz = 12
        for _, l in pairs(S.Hitmarker) do l.Visible = true end
        S.Hitmarker.L1.From = Vector2.new(cx - sz, cy - sz)
        S.Hitmarker.L1.To   = Vector2.new(cx - 4, cy - 4)
        S.Hitmarker.L2.From = Vector2.new(cx + sz, cy - sz)
        S.Hitmarker.L2.To   = Vector2.new(cx + 4, cy - 4)
        S.Hitmarker.L3.From = Vector2.new(cx - sz, cy + sz)
        S.Hitmarker.L3.To   = Vector2.new(cx - 4, cy + 4)
        S.Hitmarker.L4.From = Vector2.new(cx + sz, cy + sz)
        S.Hitmarker.L4.To   = Vector2.new(cx + 4, cy + 4)
    else
        for _, l in pairs(S.Hitmarker) do l.Visible = false end
    end

    -- Vignette
    if S.Vignette then
        Services.TweenService:Create(S.Vignette, TweenInfo.new(0.3),
            {BackgroundTransparency = Slots.Vignette.enabled and 0.5 or 1}):Play()
    end

    -- Cinematic bars
    if S.BarsTop and S.BarsBottom then
        S.BarsTop.Visible = Slots.CinematicBars.enabled
        S.BarsBottom.Visible = Slots.CinematicBars.enabled
    end

    -- Damage overlay
    if S.Damage then
        S.Damage.BackgroundTransparency = Slots.DamageOverlay.enabled and 0.85 or 1
    end

    -- Frost overlay (просто голубоватый полупрозрачный слой)
    if Slots.FrostOverlay.enabled then
        if S.Vignette then S.Vignette.BackgroundColor3 = Color3.fromRGB(180,220,255) end
    elseif Slots.Vignette.enabled then
        if S.Vignette then S.Vignette.BackgroundColor3 = Color3.fromRGB(0,0,0) end
    end
end

