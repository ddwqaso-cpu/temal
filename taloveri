local CONFIG = {
    Discord = "https://discord.gg/NfZwqG6e2",
    ToggleKey = Enum.KeyCode.RightShift,
    Transparency = 0.05,
    Accent = Color3.fromRGB(138, 92, 246),
    Bg = Color3.fromRGB(20, 20, 24),
    Panel = Color3.fromRGB(28, 28, 34),
    Stroke = Color3.fromRGB(60, 60, 70),
    Text = Color3.fromRGB(235, 235, 240),
    SubText = Color3.fromRGB(150, 150, 160),
}

local Core = {
    Functions = {},
    TabPages = {},
    TabButtons = {},
    TransparencyRefs = {},
    Visible = true,
    Config = CONFIG,
}

local function new(class, props, parent)
    local inst = Instance.new(class)
    for k,v in pairs(props or {}) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end
local function corner(parent, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, parent) end
local function stroke(parent, color, thick)
    return new("UIStroke", {Color = color or CONFIG.Stroke, Thickness = thick or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, parent)
end
local function padding(parent, p)
    return new("UIPadding", {PaddingTop=UDim.new(0,p),PaddingBottom=UDim.new(0,p),PaddingLeft=UDim.new(0,p),PaddingRight=UDim.new(0,p)}, parent)
end

function Core:Register(name) self.Functions[name] = true; return name end
function Core:trackTransparency(inst, base) table.insert(self.TransparencyRefs, {inst=inst, base=base}) end
function Core:SetTransparency(v)
    CONFIG.Transparency = v
    for _, ref in ipairs(self.TransparencyRefs) do
        pcall(function() ref.inst.BackgroundTransparency = math.clamp(ref.base + v, 0, 1) end)
    end
end

function Core:Toast(title, subtitle, duration)
    if not self.Gui then return end
    local toast = new("Frame", {
        Size = UDim2.new(0, 320, 0, 70),
        Position = UDim2.new(0.5, -160, 1, 40),
        BackgroundColor3 = Color3.fromRGB(18,18,22),
        BackgroundTransparency = 0.05,
        Parent = self.Gui,
        ZIndex = 999,
    })
    corner(toast, 10); stroke(toast, Color3.fromRGB(70,70,80), 1)
    new("ImageLabel", {
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(0, 16, 0, 22),
        BackgroundTransparency = 1,
        Image = "rbxassetid://6035047409",
        ImageColor3 = Color3.fromRGB(235,235,240),
        Parent = toast,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -60, 0, 22), Position = UDim2.new(0, 56, 0, 14),
        BackgroundTransparency = 1, Text = title, TextColor3 = CONFIG.Text,
        Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = toast,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -60, 0, 18), Position = UDim2.new(0, 56, 0, 38),
        BackgroundTransparency = 1, Text = subtitle or "", TextColor3 = CONFIG.SubText,
        Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = toast,
    })
    local info = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(toast, info, {Position = UDim2.new(0.5, -160, 1, -100)}):Play()
    task.delay(duration or 3, function()
        local out = TweenService:Create(toast, info, {Position = UDim2.new(0.5, -160, 1, 40)})
        out:Play(); out.Completed:Connect(function() toast:Destroy() end)
    end)
end

function Core:CreateGui()
    local ex = CoreGui:FindFirstChild("PhantomHvH"); if ex then ex:Destroy() end
    local gui = new("ScreenGui", {Name="PhantomHvH", ResetOnSpawn=false, IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Parent=CoreGui})
    self.Gui = gui
    local main = new("Frame", {
        Name="Main", Size=UDim2.new(0,1080,0,600), Position=UDim2.new(0.5,-540,0.5,-300),
        BackgroundColor3=CONFIG.Bg, BackgroundTransparency=CONFIG.Transparency,
        BorderSizePixel=0, Parent=gui,
    })
    corner(main, 12); stroke(main, CONFIG.Stroke, 1)
    self.Main = main

    local titleBar = new("Frame", {
        Size=UDim2.new(1,0,0,40), BackgroundColor3=Color3.fromRGB(24,24,30),
        BackgroundTransparency=CONFIG.Transparency, BorderSizePixel=0, Parent=main,
    })
    corner(titleBar, 12)
    new("Frame", {Size=UDim2.new(1,0,0,14), Position=UDim2.new(0,0,1,-14),
        BackgroundColor3=Color3.fromRGB(24,24,30), BackgroundTransparency=CONFIG.Transparency,
        BorderSizePixel=0, Parent=titleBar})
    new("TextLabel", {
        Size=UDim2.new(0,300,1,0), Position=UDim2.new(0,16,0,0),
        BackgroundTransparency=1, Text="PHANTOM | HvH v3.0", TextColor3=CONFIG.Accent,
        Font=Enum.Font.GothamBold, TextSize=18, TextXAlignment=Enum.TextXAlignment.Left,
        Parent=titleBar,
    })
    local disc = new("TextButton", {
        Size=UDim2.new(0,100,0,26), Position=UDim2.new(1,-120,0,7),
        BackgroundColor3=CONFIG.Accent, Text="Discord", TextColor3=Color3.new(1,1,1),
        Font=Enum.Font.GothamBold, TextSize=14, BorderSizePixel=0, Parent=titleBar,
    })
    corner(disc, 6)
    disc.MouseButton1Click:Connect(function()
        pcall(function() setclipboard(CONFIG.Discord) end)
        self:Toast("Discord скопирован", CONFIG.Discord, 3)
    end)

    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging=true; dragStart=input.Position; startPos=main.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end
    end)

    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == CONFIG.ToggleKey then
            self.Visible = not self.Visible
            main.Visible = self.Visible
            if not self.Visible then
                self:Toast("Interface Hidden", "Tap "..CONFIG.ToggleKey.Name.." to reopen the interface", 3)
            end
        end
    end)
end

function Core:BuildLayout()
    local main = self.Main
    local sidebar = new("Frame", {
        Size=UDim2.new(0,180,1,-60), Position=UDim2.new(0,10,0,50),
        BackgroundColor3=CONFIG.Panel, BackgroundTransparency=CONFIG.Transparency,
        BorderSizePixel=0, Parent=main,
    })
    corner(sidebar, 10); stroke(sidebar, CONFIG.Stroke, 1); padding(sidebar, 8)
    self:trackTransparency(sidebar, 0)
    self.Sidebar = sidebar
    new("UIListLayout", {Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, Parent=sidebar})
    local content = new("Frame", {
        Size=UDim2.new(1,-210,1,-60), Position=UDim2.new(0,200,0,50),
        BackgroundTransparency=1, Parent=main,
    })
    self.Content = content
end
--[[ PHANTOM | HvH v3.0 - Part 2/7 : TABS + CONTROLS ]]

function Core:AddTab(name)
    local btn = new("TextButton", {
        Size=UDim2.new(1,0,0,32), BackgroundColor3=Color3.fromRGB(34,34,40),
        BackgroundTransparency=0.3, Text="  "..name, TextColor3=CONFIG.SubText,
        Font=Enum.Font.GothamMedium, TextSize=14, TextXAlignment=Enum.TextXAlignment.Left,
        BorderSizePixel=0, Parent=self.Sidebar, AutoButtonColor=false,
    })
    corner(btn, 6)
    self:trackTransparency(btn, 0.3)

    local page = new("ScrollingFrame", {
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=4, ScrollBarImageColor3=CONFIG.Accent,
        CanvasSize=UDim2.new(0,0,0,0), Visible=false, Parent=self.Content,
    })
    padding(page, 4)
    local grid = new("UIGridLayout", {
        CellSize=UDim2.new(0,320,0,24), CellPadding=UDim2.new(0,12,0,8),
        SortOrder=Enum.SortOrder.LayoutOrder, Parent=page,
    })

    local data = {Name=name, Button=btn, Page=page, Grid=grid, Items={}}
    self.TabPages[name] = data
    table.insert(self.TabButtons, data)

    btn.MouseButton1Click:Connect(function() self:SelectTab(name) end)

    grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0,0,0, grid.AbsoluteContentSize.Y + 20)
    end)
    return data
end

function Core:SelectTab(name)
    for _, tab in ipairs(self.TabButtons) do
        local active = (tab.Name == name)
        tab.Page.Visible = active
        TweenService:Create(tab.Button, TweenInfo.new(0.15), {
            BackgroundColor3 = active and CONFIG.Accent or Color3.fromRGB(34,34,40),
            TextColor3 = active and Color3.new(1,1,1) or CONFIG.SubText,
        }):Play()
    end
end

function Core:AddSection(tab, title)
    local header = new("Frame", {Size=UDim2.new(1,0,0,28), BackgroundTransparency=1, Parent=tab.Page})
    new("TextLabel", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text=title,
        TextColor3=CONFIG.Accent, Font=Enum.Font.GothamBold, TextSize=15,
        TextXAlignment=Enum.TextXAlignment.Left, Parent=header})
    new("Frame", {Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=CONFIG.Stroke, BorderSizePixel=0, Parent=header})
    table.insert(tab.Items, header)
    return header
end

local function makeRow(tab, label)
    local row = new("Frame", {Size=UDim2.new(1,0,0,24), BackgroundTransparency=1, Parent=tab.Page})
    new("TextLabel", {Size=UDim2.new(1,-100,1,0), BackgroundTransparency=1, Text=label,
        TextColor3=CONFIG.Text, Font=Enum.Font.Gotham, TextSize=13,
        TextXAlignment=Enum.TextXAlignment.Left, Parent=row})
    table.insert(tab.Items, row)
    return row
end

function Core:AddCheckbox(tab, label, default, callback)
    self:Register("checkbox:"..label)
    local row = makeRow(tab, label)
    local state = default or false
    local box = new("TextButton", {
        Size=UDim2.new(0,20,0,20), Position=UDim2.new(1,-20,0.5,-10),
        BackgroundColor3=state and CONFIG.Accent or Color3.fromRGB(40,40,48),
        Text="", BorderSizePixel=0, Parent=row, AutoButtonColor=false,
    })
    corner(box,5); stroke(box, CONFIG.Stroke, 1)
    local check = new("TextLabel", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Text="✓", TextColor3=Color3.new(1,1,1), Font=Enum.Font.GothamBold,
        TextSize=14, Visible=state, Parent=box})
    box.MouseButton1Click:Connect(function()
        state = not state
        check.Visible = state
        TweenService:Create(box, TweenInfo.new(0.12), {
            BackgroundColor3 = state and CONFIG.Accent or Color3.fromRGB(40,40,48)
        }):Play()
        if callback then callback(state) end
    end)
    return {
        Set=function(v) state=v; check.Visible=v; box.BackgroundColor3=v and CONFIG.Accent or Color3.fromRGB(40,40,48) end,
        Get=function() return state end
    }
end

function Core:AddSlider(tab, label, minV, maxV, default, callback)
    self:Register("slider:"..label)
    minV, maxV = minV or 0, maxV or 100
    local value = default or minV
    local row = makeRow(tab, label); row.Size = UDim2.new(1,0,0,40)
    local valLbl = new("TextLabel", {Size=UDim2.new(0,60,0,20), Position=UDim2.new(1,-60,0,0),
        BackgroundTransparency=1, Text=tostring(value), TextColor3=CONFIG.Accent,
        Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=Enum.TextXAlignment.Right, Parent=row})
    local bar = new("Frame", {Size=UDim2.new(1,0,0,6), Position=UDim2.new(0,0,0,28),
        BackgroundColor3=Color3.fromRGB(40,40,48), BorderSizePixel=0, Parent=row})
    corner(bar,3)
    local fill = new("Frame", {Size=UDim2.new((value-minV)/(maxV-minV),0,1,0),
        BackgroundColor3=CONFIG.Accent, BorderSizePixel=0, Parent=bar})
    corner(fill,3)
    local knob = new("Frame", {Size=UDim2.new(0,14,0,14),
        Position=UDim2.new((value-minV)/(maxV-minV),-7,0.5,-7),
        BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, Parent=bar, ZIndex=2})
    corner(knob,7)
    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(minV + rel*(maxV-minV) + 0.5)
        fill.Size = UDim2.new(rel,0,1,0); knob.Position = UDim2.new(rel,-7,0.5,-7)
        valLbl.Text = tostring(value)
        if callback then callback(value) end
    end
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=true; update(i) end end)
    UIS.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then update(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end end)
    return {
        Set=function(v) value=v; fill.Size=UDim2.new((v-minV)/(maxV-minV),0,1,0); knob.Position=UDim2.new((v-minV)/(maxV-minV),-7,0.5,-7); valLbl.Text=tostring(v) end,
        Get=function() return value end
    }
end

function Core:AddButton(tab, label, callback)
    self:Register("button:"..label)
    local btn = new("TextButton", {
        Size=UDim2.new(1,0,0,26), BackgroundColor3=Color3.fromRGB(34,34,40),
        Text=label, TextColor3=CONFIG.Text, Font=Enum.Font.GothamMedium,
        TextSize=13, BorderSizePixel=0, Parent=tab.Page, AutoButtonColor=false,
    })
    corner(btn,6); stroke(btn, CONFIG.Stroke, 1)
    self:trackTransparency(btn, 0)
    table.insert(tab.Items, btn)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3=CONFIG.Accent}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3=Color3.fromRGB(34,34,40)}):Play() end)
    btn.MouseButton1Click:Connect(function() if callback then callback() end end)
    return btn
end

function Core:AddTextbox(tab, label, default, callback)
    self:Register("textbox:"..label)
    local row = makeRow(tab, label)
    local box = new("TextBox", {
        Size=UDim2.new(0,120,0,20), Position=UDim2.new(1,-120,0.5,-10),
        BackgroundColor3=Color3.fromRGB(34,34,40), Text=default or "",
        TextColor3=CONFIG.Text, PlaceholderText="...", PlaceholderColor3=CONFIG.SubText,
        Font=Enum.Font.Gotham, TextSize=12, BorderSizePixel=0, ClearTextOnFocus=false, Parent=row,
    })
    corner(box,5); stroke(box, CONFIG.Stroke, 1); self:trackTransparency(box, 0)
    box.FocusLost:Connect(function() if callback then callback(box.Text) end end)
    return box
end

function Core:AddDropdown(tab, label, options, default, callback)
    self:Register("dropdown:"..label)
    local row = makeRow(tab, label); row.Size = UDim2.new(1,0,0,26)
    local current = default or options[1]
    local open = false
    local btn = new("TextButton", {
        Size=UDim2.new(0,120,1,0), Position=UDim2.new(1,-120,0,0),
        BackgroundColor3=Color3.fromRGB(34,34,40), Text=current, TextColor3=CONFIG.Text,
        Font=Enum.Font.Gotham, TextSize=12, BorderSizePixel=0, Parent=row, AutoButtonColor=false,
    })
    corner(btn,5); stroke(btn, CONFIG.Stroke, 1)
    local container = new("Frame", {
        Size=UDim2.new(0,120,0,0), Position=UDim2.new(1,-120,1,4),
        BackgroundColor3=Color3.fromRGB(24,24,30), BorderSizePixel=0,
        ClipsDescendants=true, Visible=false, Parent=row, ZIndex=5,
    })
    corner(container,5); stroke(container, CONFIG.Stroke, 1)
    new("UIListLayout", {Padding=UDim.new(0,2), SortOrder=Enum.SortOrder.LayoutOrder, Parent=container})
    padding(container, 4)
    for _, opt in ipairs(options) do
        local o = new("TextButton", {
            Size=UDim2.new(1,0,0,20), BackgroundTransparency=1, Text=opt,
            TextColor3=CONFIG.SubText, Font=Enum.Font.Gotham, TextSize=12,
            BorderSizePixel=0, Parent=container, ZIndex=6,
        })
        o.MouseButton1Click:Connect(function()
            current = opt; btn.Text = opt; open = false
            TweenService:Create(container, TweenInfo.new(0.15), {Size=UDim2.new(0,120,0,0)}):Play()
            task.delay(0.15, function() container.Visible=false end)
            if callback then callback(opt) end
        end)
    end
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            container.Visible = true
            TweenService:Create(container, TweenInfo.new(0.15), {Size=UDim2.new(0,120,0,#options*22+8)}):Play()
        else
            TweenService:Create(container, TweenInfo.new(0.15), {Size=UDim2.new(0,120,0,0)}):Play()
            task.delay(0.15, function() container.Visible=false end)
        end
    end)
    return {Get=function() return current end}
end

function Core:AddKeybind(tab, label, default, callback)
    self:Register("keybind:"..label)
    local row = makeRow(tab, label)
    local current = default or Enum.KeyCode.RightShift
    local listening = false
    local btn = new("TextButton", {
        Size=UDim2.new(0,100,1,0), Position=UDim2.new(1,-100,0,0),
        BackgroundColor3=Color3.fromRGB(34,34,40), Text=current.Name,
        TextColor3=CONFIG.Text, Font=Enum.Font.GothamBold, TextSize=12,
        BorderSizePixel=0, Parent=row, AutoButtonColor=false,
    })
    corner(btn,5); stroke(btn, CONFIG.Stroke, 1)
    btn.MouseButton1Click:Connect(function() listening=true; btn.Text="..." end)
    UIS.InputBegan:Connect(function(input, gp)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            current = input.KeyCode; btn.Text = current.Name; listening=false
            if callback then callback(current) end
        end
    end)
    return {Get=function() return current end}
end

function Core:AddColorPicker(tab, label, default, callback)
    self:Register("color:"..label)
    local row = makeRow(tab, label)
    local color = default or Color3.fromRGB(255,255,255)
    local swatch = new("TextButton", {
        Size=UDim2.new(0,40,1,0), Position=UDim2.new(1,-40,0,0),
        BackgroundColor3=color, Text="", BorderSizePixel=0, Parent=row, AutoButtonColor=false,
    })
    corner(swatch,5); stroke(swatch, CONFIG.Stroke, 1)
    local palette = {
        Color3.fromRGB(255,0,0), Color3.fromRGB(0,255,0), Color3.fromRGB(0,0,255),
        Color3.fromRGB(255,255,0), Color3.fromRGB(255,0,255), Color3.fromRGB(0,255,255),
        Color3.fromRGB(255,255,255), Color3.fromRGB(0,0,0), CONFIG.Accent,
    }
    local popup = new("Frame", {
        Size=UDim2.new(0,150,0,60), Position=UDim2.new(1,-150,1,4),
        BackgroundColor3=Color3.fromRGB(24,24,30), BorderSizePixel=0,
        Visible=false, Parent=row, ZIndex=5,
    })
    corner(popup,5); stroke(popup, CONFIG.Stroke, 1); padding(popup, 4)
    new("UIGridLayout", {CellSize=UDim2.new(0,30,0,20), CellPadding=UDim2.new(0,4,0,4), Parent=popup})
    for _, c in ipairs(palette) do
        local sw = new("TextButton", {BackgroundColor3=c, Text="", BorderSizePixel=0, Parent=popup})
        corner(sw,4)
        sw.MouseButton1Click:Connect(function()
            color = c; swatch.BackgroundColor3 = c; popup.Visible=false
            if callback then callback(c) end
        end)
    end
    swatch.MouseButton1Click:Connect(function() popup.Visible = not popup.Visible end)
    return {Get=function() return color end, Set=function(c) color=c; swatch.BackgroundColor3=c end}
end
