--=====================================================================
-- SECTION: DRAG SYSTEM
--=====================================================================

function UI.Dragify(frame, handle)
    handle = handle or frame
    local dragging = false
    local dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                local delta = input.Position - dragStart
                frame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
end

--=====================================================================
-- SECTION: RESIZE SYSTEM (правый нижний угол)
--=====================================================================

function UI.Resizable(main, minWidth, minHeight)
    minWidth = minWidth or 400
    minHeight = minHeight or 300

    local grip = UI.New("TextButton", {
        Name = "ResizeGrip",
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(1, -18, 1, -18),
        BackgroundTransparency = 1,
        Text = "◢",
        TextColor3 = PHANTOM.Config.SubTextColor,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Parent = main
    })

    local resizing = false
    local startSize, startPos

    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            startSize = main.AbsoluteSize
            startPos = input.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    resizing = false
                end
            end)
        end
    end)

    Services.UserInputService.InputChanged:Connect(function(input)
        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - startPos
            local w = math.max(minWidth, startSize.X + delta.X)
            local h = math.max(minHeight, startSize.Y + delta.Y)
            main.Size = UDim2.new(0, w, 0, h)
        end
    end)
end

