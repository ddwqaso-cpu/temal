    local tabs = {}
    local currentTab = nil

    local function SelectTab(tabData)
        for _, t in pairs(tabs) do
            t.Container.Visible = false
            UI.Tween(t.Button, { BackgroundColor3 = PHANTOM.Config.PanelColor }, 0.15):Play()
            t.Button.TextColor3 = PHANTOM.Config.SubTextColor
            UI.Tween(t.Indicator, { Size = UDim2.new(0, 3, 0, 0) }, 0.2):Play()
        end
        tabData.Container.Visible = true
        UI.Tween(tabData.Button, { BackgroundColor3 = PHANTOM.Config.ElementColor }, 0.15):Play()
        tabData.Button.TextColor3 = PHANTOM.Config.TextColor
        UI.Tween(tabData.Indicator, { Size = UDim2.new(0, 3, 0, 22) }, 0.2):Play()
        currentTab = tabData.Name
    end

