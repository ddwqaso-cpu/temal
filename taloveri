function UI:AddSlider(parent, config)
    parent = parent.Tab or parent
    local name = config.Name or "Slider"
    local minV = config.Min or 0
    local maxV = config.Max or 100
    local default = config.Default or minV
    local increment = config.Increment or 1
    local suffix = config.Suffix or ""
    local callback = config.Callback
    local flag = config.Flag or name
    local value = U.Clamp(default, minV, maxV)

    -- Container
    local frame = UI.New("Frame", {
        Size = UDim2.new(1, -20, 0, 52),
        BackgroundColor3 = PHANTOM.Config.PanelColor,
        BorderSizePixel = 0,
        LayoutOrder = UI.NextOrder(),
        Parent = parent.Container
    })
    UI.Corner(frame, 6)

    -- Name
    UI.New("TextLabel", {
        Size = UDim2.new(1, -100, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = PHANTOM.Config.TextColor,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame
    })

    -- Value label
    local valueLabel = UI.New("TextLabel", {
        Size = UDim2.new(0, 90, 0, 18),
        Position = UDim2.new(1, -102, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(value) .. suffix,
        TextColor3 = PHANTOM.Config.SubTextColor,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame
    })

    -- Track
    local track = UI.New("Frame", {
        Size = UDim2.new(1, -24, 0, 8),
        Position = UDim2.new(0, 12, 1, -18),
        BackgroundColor3 = PHANTOM.Config.ElementColor,
        BorderSizePixel = 0,
        Parent = frame
    })
    UI.Corner(track, 4)

    -- Fill
    local initialPct = (value - minV) / (maxV - minV)
    local fill = UI.New("Frame", {
        Size = UDim2.new(initialPct, 0, 1, 0),
        BackgroundColor3 = PHANTOM.Config.AccentColor,
        BorderSizePixel = 0,
        Parent = track
    })
    UI.Corner(fill, 4)

    -- Knob
    local knob = UI.New("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(initialPct, -8, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track
    })
    UI.Corner(knob, 8)

    local dragging = false

    local function updateFromX(absX)
        local trackAbs = track.AbsolutePosition.X
        local trackWidth = track.AbsoluteSize.X
        if trackWidth <= 0 then return end
        local rel = U.Clamp((absX - trackAbs) / trackWidth, 0, 1)
        local raw = minV + rel * (maxV - minV)
        value = math.floor(raw / increment + 0.5) * increment
        value = U.Clamp(value, minV, maxV)
        local pct = (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -8, 0.5, -8)
        valueLabel.Text = tostring(value) .. suffix
        if callback then pcall(callback, value) end
    end

    local btn = UI.New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 3,
        Parent = track
    })

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)

    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                         or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)

    Services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Name = name,
        Flag = flag,
        Frame = frame,
        Get = function() return value end,
        Set = function(v)
            value = U.Clamp(v, minV, maxV)
            local pct = (value - minV) / (maxV - minV)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, -8, 0.5, -8)
            valueLabel.Text = tostring(value) .. suffix
            if callback then pcall(callback, value) end
        end
    }
end
