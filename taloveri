PHANTOM.Visuals.Cleanup = function(self)
    for player, _ in pairs(self.ESPRegistry) do
        self:DestroyESP(player)
    end
    self.ESPRegistry = {}

    if self.FOVCircle then
        pcall(function() self.FOVCircle:Remove() end)
        self.FOVCircle = nil
    end

    local S = self._Screen
    for _, l in pairs(S.Crosshair) do pcall(function() l:Remove() end) end
    for _, l in pairs(S.Hitmarker) do pcall(function() l:Remove() end) end
    if S.Vignette then pcall(function() S.Vignette:Destroy() end) end
    if S.BarsTop then pcall(function() S.BarsTop:Destroy() end) end
    if S.BarsBottom then pcall(function() S.BarsBottom:Destroy() end) end
    if S.Damage then pcall(function() S.Damage:Destroy() end) end

    for _, t in pairs(self._InfoDrawings) do
        pcall(function() t:Remove() end)
    end
    self._InfoDrawings = {}

    -- Lighting reset
    local L = Services.Lighting
    local O = self._LightingOriginal
    L.Brightness = O.Brightness
    L.ClockTime = O.ClockTime
    L.GlobalShadows = O.GlobalShadows
    L.FogEnd = O.FogEnd
    L.FogStart = O.FogStart
    L.Ambient = O.Ambient
    L.OutdoorAmbient = O.OutdoorAmbient
    for _, name in ipairs({"PhantomCC", "PhantomBloom"}) do
        local o = L:FindFirstChild(name)
        if o then o:Destroy() end
    end
end

--=====================================================================
-- SECTION: MAIN RENDER LOOP
--=====================================================================

PHANTOM.Visuals.RenderLoop = function(self)
    PHANTOM.Aimbot:DrawFOVCircle()
    self:ApplyLighting()
    self:UpdateScreen()
    self:UpdateInfoOverlay()

    local S = self.Slots
    local anyESP = S.ESPEnabled.enabled
    local anyChams = S.ChamsEnabled.enabled

    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player == LocalPlayer then
            if anyChams then
                self:UpdateChams(player, self.ESPRegistry[player] or {})
            end
            continue
        end

        if not self.ESPRegistry[player] then
            self:CreateESP(player)
        end
        local reg = self.ESPRegistry[player]
        if not reg then continue end

        if anyESP then
            self:UpdateESP(player, reg)
        else
            self:HideAll(reg)
        end

        if anyChams then
            self:UpdateChams(player, reg)
        elseif reg.Chams.Highlight then
            self:DestroyChams(player)
        end
    end
end
