function UI.Tween(obj, props, duration, style, direction)
    return Services.TweenService:Create(
        obj,
        TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
        props
    )
end

function UI.FadeIn(obj, duration)
    local target = obj.BackgroundTransparency ~= nil
        and (obj.BackgroundTransparency < 1 and obj.BackgroundTransparency or 0)
        or nil
    obj.BackgroundTransparency = 1
    UI.Tween(obj, { BackgroundTransparency = target or 0 }, duration or 0.25):Play()
end

function UI.ScaleIn(frame, duration)
    local origSize = frame.Size
    frame.Size = UDim2.new(0, 0, 0, 0)
    UI.Tween(frame, { Size = origSize }, duration or 0.25,
        Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
end

