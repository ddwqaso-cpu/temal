        SitToggle        = { enabled = false },
        Freeze           = { enabled = false },
        Anchor           = { enabled = false },
        AntiVoid         = { enabled = false, y = -50 },
        AntiFling        = { enabled = false, savedPos = nil },
        AntiRagdoll      = { enabled = false },
        GodMode          = { enabled = false },
        InfiniteHealth   = { enabled = false },

        -- [21-30] AUTOMATION
        AutoFarm         = { enabled = false, range = 30, lastAttack = 0 },
        AutoCollect      = { enabled = false, range = 15, lastPickup = 0 },
        AutoQuest        = { enabled = false },
        AutoSell         = { enabled = false },
        AutoBuy          = { enabled = false },
        AutoCraft        = { enabled = false },
        Pathfinding      = { enabled = false, target = nil },
        WaypointSystem   = { enabled = false, waypoints = {} },
        MacroRecorder    = { enabled = false, recording = {}, startTime = 0 },
        MacroPlayer      = { enabled = false, playing = false },

        -- [31-40] UTILITY
        ConfigManager    = { enabled = false },
        ScriptHub        = { enabled = false },
        PositionSave     = { enabled = false, saved = nil },
        PositionLoad     = { enabled = false },
        TeleportToPlayer = { enabled = false, target = nil },
        BringPlayer      = { enabled = false, target = nil },
        FPSBoost         = { enabled = false, savedEffects = {} },
        LowGraphics      = { enabled = false, savedQuality = nil },
        HideCharacter    = { enabled = false },
        ConsoleLogger    = { enabled = false, lastLog = 0 }
    },

    Update = function(self)
        local char, hum, root = U.GetLocalCharacter()

        -- AntiAFK
        if self.Features.AntiAFK.enabled and tick() - self.Features.AntiAFK.last >= self.Features.AntiAFK.interval then
            pcall(function()
                if Services.VirtualUser then
                    Services.VirtualUser:CaptureController()
                    Services.VirtualUser:ClickButton2(Vector2.new())
                end
            end)
            self.Features.AntiAFK.last = tick()
        end

        -- AntiVoid
        if self.Features.AntiVoid.enabled and root then
            if root.Position.Y < self.Features.AntiVoid.y then
                root.CFrame = CFrame.new(root.Position.X, 50, root.Position.Z)
            end
        end

        -- AntiFling (постоянно фиксируем позицию при резком отклонении)
        if self.Features.AntiFling.enabled and root then
            local vel = root.AssemblyLinearVelocity
            if vel.Magnitude > 300 then
                root.AssemblyLinearVelocity = Vector3.new(0,0,0)
            end
        end

        -- AntiRagdoll
        if self.Features.AntiRagdoll.enabled and hum then
            hum.PlatformStand = false
        end

        -- Freeze
        if self.Features.Freeze.enabled and hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end

        -- Anchor
        if root then
            root.Anchored = self.Features.Anchor.enabled
        end

        -- GodMode
        if self.Features.GodMode.enabled and char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end

        -- Infinite Health
        if self.Features.InfiniteHealth.enabled and hum then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
        end

        -- AutoFarm (базовый)
        if self.Features.AutoFarm.enabled and root and tick() - self.Features.AutoFarm.lastAttack > 0.5 then
            local closest, cd = nil, self.Features.AutoFarm.range
            for _, obj in ipairs(Services.Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= char then
                    local h = obj:FindFirstChildOfClass("Humanoid")
                    local r = obj:FindFirstChild("HumanoidRootPart")
                    if h and r and h.Health > 0 then
                        local d = (r.Position - root.Position).Magnitude
                        if d < cd then cd = d closest = obj end
                    end
                end
            end
            if closest then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
                self.Features.AutoFarm.lastAttack = tick()
            end
        end

        -- AutoCollect (сбор предметов вокруг)
        if self.Features.AutoCollect.enabled and root and tick() - self.Features.AutoCollect.lastPickup > 0.3 then
            for _, obj in ipairs(Services.Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj ~= root and not obj:IsDescendantOf(char) then
                    local d = (obj.Position - root.Position).Magnitude
                    if d < self.Features.AutoCollect.range and obj.CanCollide then
                        local name = obj.Name:lower()
                        if name:find("coin") or name:find("cash") or name:find("gem")
                           or name:find("drop") or name:find("item") then
                            pcall(function()
                                if firetouchinterest then
                                    firetouchinterest(root, obj, 0)
                                    firetouchinterest(root, obj, 1)
                                end
                            end)
                            self.Features.AutoCollect.lastPickup = tick()
                            break
                        end
                    end
                end
            end
        end

        -- TeleportToPlayer
        if self.Features.TeleportToPlayer.enabled and self.Features.TeleportToPlayer.target and root then
            local target = self.Features.TeleportToPlayer.target
            local _, _, tr = U.GetCharacter(target)
            if tr then
                root.CFrame = CFrame.new(tr.Position + Vector3.new(0, 3, 0))
            end
            self.Features.TeleportToPlayer.enabled = false
        end

        -- BringPlayer
        if self.Features.BringPlayer.enabled and self.Features.BringPlayer.target and root then
            local target = self.Features.BringPlayer.target
            local _, _, tr = U.GetCharacter(target)
            if tr then
                tr.CFrame = CFrame.new(root.Position + Vector3.new(0, 3, 0))
            end
            self.Features.BringPlayer.enabled = false
        end

        -- FPS Boost (отключаем пост-эффекты)
        if self.Features.FPSBoost.enabled then
            for _, obj in ipairs(Services.Lighting:GetChildren()) do
                if obj:IsA("PostEffect") and obj.Enabled then
                    obj.Enabled = false
                    table.insert(self.Features.FPSBoost.savedEffects, obj)
                end
            end
        end

        -- Low Graphics
        if self.Features.LowGraphics.enabled then
            pcall(function() settings().Rendering.QualityLevel = 1 end)
        end

        -- HideCharacter
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.LocalTransparencyModifier = self.Features.HideCharacter.enabled and 1 or 0
                end
            end
        end
    end,

    -- =========================================================
    -- ACTIONS (для кнопок UI)
    -- =========================================================
    CopyJobID = function()
        pcall(function() setclipboard(game.JobId) end)
        PHANTOM.ShowToast("Job ID", "Скопирован: " .. game.JobId, 3)
    end,

    CopyPlaceID = function()
        pcall(function() setclipboard(tostring(game.PlaceId)) end)
        PHANTOM.ShowToast("Place ID", "Скопирован: " .. tostring(game.PlaceId), 3)
    end,

    ServerHop = function()
        pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            local res = game:HttpGet(url)
            local data = Services.HttpService:JSONDecode(res)
            for _, srv in ipairs(data.data or {}) do
                if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                    Services.TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                    return
                end
            end
            PHANTOM.ShowToast("Server Hop", "Свободных серверов нет", 3)
        end)
    end,

    Rejoin = function()
        pcall(function()
            Services.TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
    end,

    Reset = function()
        local char = LocalPlayer.Character
        if char then
            pcall(function() char:BreakJoints() end)
        end
    end,

    SavePosition = function()
        local _, _, root = U.GetLocalCharacter()
        if root then
            PHANTOM.Misc.Features.PositionSave.saved = root.CFrame
            PHANTOM.ShowToast("Position Save", "Позиция сохранена", 2)
        end
    end,

    LoadPosition = function()
        local _, _, root = U.GetLocalCharacter()
        local saved = PHANTOM.Misc.Features.PositionSave.saved
        if root and saved then
            root.CFrame = saved
        end
    end
}
