    -- =========================================================
    -- UPDATE ESP — вызывается каждый кадр для каждого игрока
    -- =========================================================
    UpdateESP = function(self, player, reg)
        local char = player.Character
        local function hideAll()
            for _, g in pairs(reg) do
                if type(g) == "table" then
                    for _, o in pairs(g) do
                        if type(o) == "table" and o.Visible ~= nil then o.Visible = false end
                        if type(o) == "userdata" and o.Visible ~= nil then o.Visible = false end
                    end
                end
            end
            if reg.Skeleton and reg.Skeleton.Lines then
                for _, l in ipairs(reg.Skeleton.Lines) do l.Visible = false end
            end
        end
        if not char then hideAll() return end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not head or not hum or hum.Health <= 0 then hideAll() return end

        -- MaxDistance check
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if self.Slots.MaxDistance.enabled and dist > self.Slots.MaxDistance.value then hideAll() return end

        -- VisibleOnly check
        if self.Slots.VisibleOnly.enabled then
            local ray = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * dist)
            local hit = Services.Workspace:FindPartOnRay(ray, LocalPlayer.Character)
            if hit and not hit:IsDescendantOf(char) then hideAll() return end
        end

        local rootPos, rootOn = Camera:WorldToViewportPoint(root.Position)
        local headPos, headOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
        local bottomPos, bottomOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
        if not rootOn or not headOn or not bottomOn then hideAll() return end

        -- Team color
        local color = self.Slots.Box.color
        if player.Team and LocalPlayer.Team then
            if player.Team == LocalPlayer.Team then color = Color3.fromRGB(0,255,100)
            else color = Color3.fromRGB(255,50,50) end
        end

        local boxH = math.abs(headPos.Y - bottomPos.Y)
        local boxW = boxH * 0.6
        local TL = Vector2.new(rootPos.X - boxW/2, headPos.Y)
        local TR = Vector2.new(rootPos.X + boxW/2, headPos.Y)
        local BR = Vector2.new(rootPos.X + boxW/2, bottomPos.Y)
        local BL = Vector2.new(rootPos.X - boxW/2, bottomPos.Y)

        -- Box
        if self.Slots.ESPEnabled.enabled and self.Slots.Box.enabled then
            reg.Box.Outline.Visible = true
            reg.Box.Outline.PointA, reg.Box.Outline.PointB = TL, TR
            reg.Box.Outline.PointC, reg.Box.Outline.PointD = BR, BL
            reg.Box.Main.Visible = true
            reg.Box.Main.PointA, reg.Box.Main.PointB = TL, TR
            reg.Box.Main.PointC, reg.Box.Main.PointD = BR, BL
            reg.Box.Main.Color = color
            reg.Box.Main.Thickness = self.Slots.Box.thickness
        else
            reg.Box.Outline.Visible = false
            reg.Box.Main.Visible = false
        end

        -- Tracer
        if self.Slots.ESPEnabled.enabled and self.Slots.Tracer.enabled then
            reg.Tracer.Line.Visible = true
            reg.Tracer.Line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            reg.Tracer.Line.To = Vector2.new(rootPos.X, bottomPos.Y)
            reg.Tracer.Line.Color = color
            reg.Tracer.Line.Thickness = self.Slots.Tracer.thickness
        else reg.Tracer.Line.Visible = false end

        -- HeadDot
        if self.Slots.ESPEnabled.enabled and self.Slots.HeadDot.enabled then
            reg.HeadDot.Circle.Visible = true
            reg.HeadDot.Circle.Position = Vector2.new(headPos.X, headPos.Y)
            reg.HeadDot.Circle.Color = self.Slots.HeadDot.color
            reg.HeadDot.Circle.Radius = self.Slots.HeadDot.radius
        else reg.HeadDot.Circle.Visible = false end

        -- Name
        if self.Slots.ESPEnabled.enabled and self.Slots.Name.enabled then
            reg.Name.Text.Visible = true
            reg.Name.Text.Position = Vector2.new(rootPos.X, headPos.Y - 18)
            reg.Name.Text.Text = player.Name
            reg.Name.Text.Color = self.Slots.Name.color
            reg.Name.Text.Size = self.Slots.Name.size
        else reg.Name.Text.Visible = false end

        -- Distance
        if self.Slots.ESPEnabled.enabled and self.Slots.Distance.enabled then
            reg.Distance.Text.Visible = true
            reg.Distance.Text.Position = Vector2.new(rootPos.X, bottomPos.Y + 4)
            reg.Distance.Text.Text = string.format("[%d studs]", math.floor(dist))
            reg.Distance.Text.Color = self.Slots.Distance.color
        else reg.Distance.Text.Visible = false end

        -- Health
        if self.Slots.ESPEnabled.enabled and self.Slots.Health.enabled then
            local hp = hum.Health / math.max(hum.MaxHealth, 1)
            local barX = rootPos.X + boxW/2 + 6
            reg.Health.Bg.Visible = true
            reg.Health.Bg.From = Vector2.new(barX, headPos.Y)
            reg.Health.Bg.To = Vector2.new(barX, bottomPos.Y)
            reg.Health.Fill.Visible = true
            reg.Health.Fill.From = Vector2.new(barX, headPos.Y)
            reg.Health.Fill.To = Vector2.new(barX, headPos.Y + boxH * hp)
            reg.Health.Fill.Color = Color3.fromRGB(255 * (1-hp), 255 * hp, 0)
        else
            reg.Health.Bg.Visible = false
            reg.Health.Fill.Visible = false
        end

        -- Skeleton
        local skelOn = self.Slots.ESPEnabled.enabled and
            (self.Slots.Skeleton.enabled or self.Slots.SkeletonThick.enabled
             or self.Slots.SkeletonNeon.enabled or self.Slots.SkeletonRainbow.enabled
             or self.Slots.SkeletonPriority.enabled)
        if skelOn then
            local mode = self.Slots.Skeleton
            local thick = 1
            local col = self.Slots.Skeleton.color
            if self.Slots.SkeletonThick.enabled then thick = self.Slots.SkeletonThick.thickness col = self.Slots.SkeletonThick.color end
            if self.Slots.SkeletonNeon.enabled then thick = self.Slots.SkeletonNeon.thickness col = self.Slots.SkeletonNeon.color end
            if self.Slots.SkeletonPriority.enabled then thick = self.Slots.SkeletonPriority.thickness col = self.Slots.SkeletonPriority.color end
            if self.Slots.SkeletonRainbow.enabled then
                local t = tick() * self.Slots.SkeletonRainbow.speed
                col = Color3.fromHSV((t % 1), 1, 1)
            end
            for i, pair_ in ipairs(self.Bones) do
                local a = char:FindFirstChild(pair_[1])
                local b = char:FindFirstChild(pair_[2])
                local line = reg.Skeleton.Lines[i]
                if a and b and line then
                    local ap, aOn = Camera:WorldToViewportPoint(a.Position)
                    local bp, bOn = Camera:WorldToViewportPoint(b.Position)
                    if aOn and bOn then
                        line.Visible = true
                        line.From = Vector2.new(ap.X, ap.Y)
                        line.To = Vector2.new(bp.X, bp.Y)
                        line.Color = col
                        line.Thickness = thick
                    else line.Visible = false end
                elseif line then line.Visible = false end
            end
        else
            for _, l in ipairs(reg.Skeleton.Lines) do l.Visible = false end
        end
    end,
    -- =========================================================
    -- WORLD LIGHTING
    -- =========================================================
    ApplyLighting = function(self)
        local L = Services.Lighting
        if self.Slots.FullBright.enabled then
            L.Brightness = 3
            L.ClockTime = 14
            L.GlobalShadows = false
            L.FogEnd = 100000
        end
        if self.Slots.NoFog.enabled then
            L.FogEnd = 100000
            L.FogStart = 100000
        end
        if self.Slots.AmbientLight.enabled then
            L.Ambient = self.Slots.AmbientLight.color
        end
        if self.Slots.OutdoorAmbient.enabled then
            L.OutdoorAmbient = self.Slots.OutdoorAmbient.color
        end
        if self.Slots.ClockTime.enabled then
            L.ClockTime = self.Slots.ClockTime.value
        end
        if self.Slots.ForceField.enabled then
            for _, p in ipairs(LocalPlayer.Character and LocalPlayer.Character:GetChildren() or {}) do
                if p:IsA("ForceField") then p.Visible = true end
            end
        end
    end,

    ResetLighting = function(self)
        local L = Services.Lighting
        L.Brightness = 2
        L.ClockTime = 14
        L.GlobalShadows = true
        L.FogEnd = 100000
        L.FogStart = 0
        L.Ambient = Color3.fromRGB(70,70,70)
        L.OutdoorAmbient = Color3.fromRGB(128,128,128)
    end,

    -- =========================================================
    -- SCREEN — Crosshair / Hitmarker / Overlays
    -- =========================================================
    Screen = { Crosshair = {}, Hitmarker = {}, Bars = {}, Vignette = nil, Snow = nil },

    CreateScreen = function(self)
        local S = self.Screen
        if not S.Crosshair.Line1 then
            S.Crosshair.Line1 = Drawing.new("Line")
            S.Crosshair.Line2 = Drawing.new("Line")
            S.Crosshair.Line3 = Drawing.new("Line")
            S.Crosshair.Line4 = Drawing.new("Line")
            for _, l in pairs(S.Crosshair) do
                l.Thickness = 1
                l.Visible = false
            end
        end
        if not S.Hitmarker.L1 then
            S.Hitmarker.L1 = Drawing.new("Line")
            S.Hitmarker.L2 = Drawing.new("Line")
            S.Hitmarker.L3 = Drawing.new("Line")
            S.Hitmarker.L4 = Drawing.new("Line")
            for _, l in pairs(S.Hitmarker) do
                l.Thickness = 2
                l.Color = Color3.fromRGB(255,255,255)
                l.Visible = false
            end
        end
    end,

    UpdateScreen = function(self)
        local S = self.Screen
        local vp = Camera.ViewportSize
        local cx, cy = vp.X/2, vp.Y/2

        -- Crosshair
        if S.Crosshair.Line1 then
            local on = self.Slots.Crosshair.enabled
            local sz = self.Slots.CrosshairSize.value
            local col = self.Slots.CrosshairColor.color
            S.Crosshair.Line1.Visible = on
            S.Crosshair.Line2.Visible = on
            S.Crosshair.Line3.Visible = on
            S.Crosshair.Line4.Visible = on
            if on then
                S.Crosshair.Line1.From = Vector2.new(cx, cy - sz)
                S.Crosshair.Line1.To   = Vector2.new(cx, cy - 2)
                S.Crosshair.Line2.From = Vector2.new(cx, cy + 2)
                S.Crosshair.Line2.To   = Vector2.new(cx, cy + sz)
                S.Crosshair.Line3.From = Vector2.new(cx - sz, cy)
                S.Crosshair.Line3.To   = Vector2.new(cx - 2, cy)
                S.Crosshair.Line4.From = Vector2.new(cx + 2, cy)
                S.Crosshair.Line4.To   = Vector2.new(cx + sz, cy)
                for _, l in pairs(S.Crosshair) do l.Color = col end
            end
        end
    end,

    -- =========================================================
    -- MAIN RENDER LOOP
    -- =========================================================
    RenderLoop = function(self)
        self:DrawFOVCircle()
        self:ApplyLighting()
        self:UpdateScreen()

        local anyESP = self.Slots.ESPEnabled.enabled and
            (self.Slots.Box.enabled or self.Slots.Tracer.enabled or self.Slots.HeadDot.enabled
             or self.Slots.Name.enabled or self.Slots.Health.enabled or self.Slots.Distance.enabled
             or self.Slots.Skeleton.enabled or self.Slots.SkeletonThick.enabled
             or self.Slots.SkeletonNeon.enabled or self.Slots.SkeletonRainbow.enabled
             or self.Slots.SkeletonPriority.enabled)

        local anyChams = self.Slots.ChamsEnabled.enabled and
            (self.Slots.SelfChams.enabled or self.Slots.TeamChams.enabled
             or self.Slots.EnemyChams.enabled or self.Slots.Outline.enabled
             or self.Slots.FillBody.enabled)

        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if not self.ESPRegistry[player] then self:CreateESP(player) end
            local reg = self.ESPRegistry[player]

            if anyESP then self:UpdateESP(player, reg)
            else
                for _, g in pairs(reg) do
                    if type(g) == "table" then
                        for _, o in pairs(g) do
                            if type(o) == "table" and o.Visible ~= nil then o.Visible = false end
                        end
                    end
                end
                for _, l in ipairs(reg.Skeleton.Lines) do l.Visible = false end
            end

            -- Chams
            if anyChams then
                self:CreateChams(player)
                local h = reg.Chams.Highlight
                if h then
                    local col = self.Slots.EnemyChams.color
                    if player == LocalPlayer and self.Slots.SelfChams.enabled then col = self.Slots.SelfChams.color
                    elseif player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team
                        and self.Slots.TeamChams.enabled then col = self.Slots.TeamChams.color
                    elseif self.Slots.EnemyChams.enabled then col = self.Slots.EnemyChams.color
                    else col = self.Slots.FillBody.color end

                    h.FillColor = col
                    h.FillTransparency = self.Slots.FillBody.transparency or 0.5
                    h.OutlineColor = self.Slots.Outline.color
                    h.OutlineTransparency = self.Slots.Outline.enabled and 0 or 1
                    h.DepthMode = self.Slots.ChamsXRay.enabled
                        and Enum.HighlightDepthMode.AlwaysOnTop
                        or Enum.HighlightDepthMode.Occluded
                end
            else
                if reg.Chams.Highlight then self:DestroyChams(player) end
            end
        end
    end,

    DrawFOVCircle = function(self)
        if not self.FOVCircle then
            local c = Drawing.new("Circle")
            c.Thickness = 1
            c.NumSides = 64
            c.Filled = false
            c.Transparency = 0.85
            self.FOVCircle = c
        end
        local c = self.FOVCircle
        c.Visible = self.Slots.FOVCircle.enabled
        if c.Visible then
            c.Color = self.Slots.FOVColor.color
            c.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            c.Radius = PHANTOM.Aimbot.FOV
        end
    end,

    Cleanup = function(self)
        for player, reg in pairs(self.ESPRegistry) do
            for _, g in pairs(reg) do
                if type(g) == "table" then
                    for _, o in pairs(g) do
                        if type(o) == "table" and o.Remove then pcall(function() o:Remove() end) end
                    end
                end
            end
            if reg.Skeleton and reg.Skeleton.Lines then
                for _, l in ipairs(reg.Skeleton.Lines) do pcall(function() l:Remove() end) end
            end
            self:DestroyChams(player)
        end
        self.ESPRegistry = {}
        if self.FOVCircle then pcall(function() self.FOVCircle:Remove() end) self.FOVCircle = nil end
    end
}
