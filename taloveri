PHANTOM.Visuals._LightingOriginal = {
    Brightness = Services.Lighting.Brightness,
    ClockTime = Services.Lighting.ClockTime,
    GlobalShadows = Services.Lighting.GlobalShadows,
    FogEnd = Services.Lighting.FogEnd,
    FogStart = Services.Lighting.FogStart,
    Ambient = Services.Lighting.Ambient,
    OutdoorAmbient = Services.Lighting.OutdoorAmbient
}

PHANTOM.Visuals.ApplyLighting = function(self)
    local L = Services.Lighting
    local S = self.Slots

    if S.FullBright.enabled then
        L.Brightness = 3
        L.ClockTime = 14
        L.GlobalShadows = false
        L.FogEnd = 1e6
        L.FogStart = 1e6
    end

    if S.NoFog.enabled then
        L.FogEnd = 1e6
        L.FogStart = 1e6
    end

    if S.AmbientLight.enabled then
        L.Ambient = S.AmbientLight.color
    end

    if S.ClockTime.enabled then
        L.ClockTime = S.ClockTime.value
    end

    if S.NoParticles.enabled then
        for _, obj in ipairs(Services.Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end
    end

    if S.NoGrass.enabled then
        pcall(function() Services.Workspace.Terrain.Decoration = false end)
    end

    if S.Skybox.enabled then
        pcall(function()
            local sky = Services.Lighting:FindFirstChildOfClass("Sky")
            if sky then sky.Parent = nil end
        end)
    end

    -- Color Correction
    if S.ColorCorrection.enabled then
        if not Services.Lighting:FindFirstChild("PhantomCC") then
            local cc = Instance.new("ColorCorrectionEffect")
            cc.Name = "PhantomCC"
            cc.Brightness = 0.05
            cc.Contrast = 0.1
            cc.Saturation = 0.15
            cc.Parent = Services.Lighting
        end
    else
        local cc = Services.Lighting:FindFirstChild("PhantomCC")
        if cc then cc:Destroy() end
    end

    -- Bloom
    if S.Bloom.enabled then
        if not Services.Lighting:FindFirstChild("PhantomBloom") then
            local b = Instance.new("BloomEffect")
            b.Name = "PhantomBloom"
            b.Intensity = 1
            b.Size = 24
            b.Threshold = 0.8
            b.Parent = Services.Lighting
        end
    else
        local b = Services.Lighting:FindFirstChild("PhantomBloom")
        if b then b:Destroy() end
    end

    -- Reset
    if S.ResetLighting.enabled then
        L.Brightness = self._LightingOriginal.Brightness
        L.ClockTime = self._LightingOriginal.ClockTime
        L.GlobalShadows = self._LightingOriginal.GlobalShadows
        L.FogEnd = self._LightingOriginal.FogEnd
        L.FogStart = self._LightingOriginal.FogStart
        L.Ambient = self._LightingOriginal.Ambient
        L.OutdoorAmbient = self._LightingOriginal.OutdoorAmbient
        S.ResetLighting.enabled = false
    end

    -- Third Person
    if S.ThirdPerson.enabled then
        LocalPlayer.CameraMaxZoomDistance = S.ThirdPerson.distance
        LocalPlayer.CameraMinZoomDistance = 0.5
    else
        LocalPlayer.CameraMaxZoomDistance = 128
        LocalPlayer.CameraMinZoomDistance = 0.5
    end

    -- Zoom
    if S.Zoom.enabled then
        Camera.FieldOfView = S.Zoom.value
    end

    -- FOV_Changer
    if S.FOV_Changer.enabled then
        Camera.FieldOfView = S.FOV_Changer.value
    end

    -- Wireframe (через MaterialOverride для Workspace)
    if S.Wireframe.enabled then
        pcall(function()
            Services.Workspace.Terrain.MaterialColors = {}
        end)
    end
end

