-- ========== SOUNDS ==========
local sounds={}
local function playSound(name,id,loop,volume)
    if sounds[name] then return end
    local s=Instance.new("Sound")
    s.Name="Phantom_"..name
    s.SoundId=id
    s.Looped=loop or false
    s.Volume=volume or 0.5
    s.Parent=Sound
    s:Play()
    sounds[name]=s
end
local function stopSound(name)
    if sounds[name] then sounds[name]:Destroy() sounds[name]=nil end
end

task.spawn(function()
    while task.wait(0.5) do
        if C.CozyAmbience then
            playSound("cozy","rbxassetid://1837879082",true,0.3)
        else stopSound("cozy") end
        if C.WindSound then
            playSound("wind","rbxassetid://5153734596",true,0.4)
        else stopSound("wind") end
        if C.FireplaceSound then
            playSound("fire","rbxassetid://6294841288",true,0.3)
        else stopSound("fire") end
        if C.JingleBells then
            playSound("jingle","rbxassetid://1837879082",true,0.4)
        else stopSound("jingle") end
        if C.MusicEnabled then
            if not sounds["music"] then
                playSound("music","rbxassetid://1837879082",true,C.MusicVolume/100)
            else
                sounds["music"].Volume=C.MusicVolume/100
            end
        else stopSound("music") end
    end
end)

