PHANTOM.Visuals.UpdateChams = function(self, player, reg)
    local S = self.Slots
    if not S.ChamsEnabled.enabled then
        if reg.Chams.Highlight then self:DestroyChams(player) end
        return
    end

    local char = player.Character
    if not char then
        if reg.Chams.Highlight then self:DestroyChams(player) end
        return
    end

    self:CreateChams(player)
    local h = reg.Chams.Highlight
    if not h then return end

    local isTeammate = player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team

    local col
    if player == LocalPlayer and S.SelfChams.enabled then col = S.SelfChams.color
    elseif isTeammate and S.TeamChams.enabled then col = S.TeamChams.color
    elseif S.EnemyChams.enabled then col = S.EnemyChams.color
    elseif S.FillBody.enabled then col = S.FillBody.color
    else col = S.EnemyChams.color end

    -- Pulse
    if S.PulseEffect.enabled then
        local p = (math.sin(tick() * S.PulseEffect.speed * 3) + 1) / 2
        col = col:Lerp(Color3.fromRGB(255,255,255), p * 0.4)
    end

    h.FillColor = col
    h.FillTransparency = (S.ChamsMode.value == "Outline") and 1 or 0.5
    h.OutlineColor = S.Outline.color
    h.OutlineTransparency = S.Outline.enabled and 0 or 1
    h.DepthMode = S.ChamsXRay.enabled
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded
end

--=====================================================================
-- SECTION: MAIN RENDER LOOP
--=====================================================================

PHANTOM.Visuals.RenderLoop = function(self)
    -- FOV circle (в Aimbot)
    PHANTOM.Aimbot:DrawFOVCircle()

    -- Apply lighting
    if PHANTOM.Visuals.ApplyLighting then
        PHANTOM.Visuals:ApplyLighting()
    end

    -- Screen (crosshair и др.)
    if PHANTOM.Visuals.UpdateScreen then
        PHANTOM.Visuals:UpdateScreen()
    end

    -- Player iteration
    local S = self.Slots
    local anyESP = S.ESPEnabled.enabled
    local anyChams = S.ChamsEnabled.enabled

    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player == LocalPlayer then
            if anyChams and (S.SelfChams.enabled or S.ChamsEnabled.enabled) then
                self:UpdateChams(player, self.ESPRegistry[player] or {})
            end
            continue
        end

        if not self.ESPRegistry[player] then
            self:CreateESP(player)
        end
        local reg = self.ESPRegistry[player]
        if not reg then continue end

        if anyESP then
            self:UpdateESP(player, reg)
        else
            self:HideAll(reg)
        end

        if anyChams then
            self:UpdateChams(player, reg)
        elseif reg.Chams.Highlight then
            self:DestroyChams(player)
        end
    end
end
