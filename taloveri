            ScrollBarThickness = 4,
            ScrollBarImageColor3 = PHANTOM.Config.AccentColor,
            Visible = false,
            Parent = content
        })
        local layout = New("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = container
        })
        Padding(container, 12)

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 24)
        end)

        local tabData = {
            Name = name,
            Button = btn,
            Container = container,
            Indicator = indicator,
            Layout = layout,
            SectionCount = 0
        }
        tabs[name] = tabData

        local function select()
            for _, t in pairs(tabs) do
                t.Container.Visible = false
                t.Button.BackgroundColor3 = PHANTOM.Config.PanelColor
                t.Button.TextColor3 = PHANTOM.Config.SubTextColor
                Services.TweenService:Create(t.Indicator, TweenInfo.new(0.2),
                    {Size = UDim2.new(0, 3, 0, 0)}):Play()
            end
            tabData.Container.Visible = true
            tabData.Button.BackgroundColor3 = PHANTOM.Config.ElementColor
            tabData.Button.TextColor3 = PHANTOM.Config.TextColor
            Services.TweenService:Create(tabData.Indicator, TweenInfo.new(0.2),
                {Size = UDim2.new(0, 3, 0, 22)}):Play()
            currentTab = name
        end

        btn.MouseButton1Click:Connect(select)
        if not currentTab then select() end

        -- Возвращаем объект с методами
        return {
            Name = name,
            Container = container,
            Layout = layout,
            _data = tabData
        }
    end

    UI.Main = main
    UI.ScreenGui = screenGui

    return {
        Main = main,
        ScreenGui = screenGui,
        CreateTab = CreateTab,
        Tabs = tabs
    }
end
