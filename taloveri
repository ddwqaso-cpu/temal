    local btn = UI.New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame
    })

    local function setState(v, fireCallback)
        state = v
        if fireCallback ~= false then
            UI.Tween(box, {
                BackgroundColor3 = v and PHANTOM.Config.AccentColor or PHANTOM.Config.ElementColor
            }, 0.15):Play()
            UI.Tween(stroke, {
