-- ========== SNOW через ParticleEmitter ==========
local snowEmitter=nil
local snowPart=nil

local function createSnow()
    if snowEmitter then return end
    local cam=workspace.CurrentCamera
    snowPart=Instance.new("Part")
    snowPart.Size=Vector3.new(2,2,2)
    snowPart.Anchored=true
    snowPart.CanCollide=false
    snowPart.Transparency=1
    snowPart.Name="PhantomSnowAttach"
    snowPart.Parent=WS
    snowEmitter=Instance.new("ParticleEmitter")
    snowEmitter.Name="PhantomSnow"
    snowEmitter.Texture="rbxassetid://243660364"
    snowEmitter.Lifetime=NumberRange.new(5,10)
    snowEmitter.Rate=C.SnowAmount
    snowEmitter.Speed=NumberRange.new(C.SnowSpeed*0.5,C.SnowSpeed)
    snowEmitter.SpreadAngle=Vector2.new(180,180)
    snowEmitter.Size=NumberSequence.new({
        NumberSequenceKeypoint.new(0,C.SnowSize),
        NumberSequenceKeypoint.new(1,C.SnowSize*0.5)
    })
    snowEmitter.Transparency=NumberSequence.new({
        NumberSequenceKeypoint.new(0,0),
        NumberSequenceKeypoint.new(0.8,0.3),
        NumberSequenceKeypoint.new(1,1)
    })
    snowEmitter.Color=ColorSequence.new(C.SnowColor)
    snowEmitter.Rotation=NumberRange.new(0,360)
    snowEmitter.RotSpeed=NumberRange.new(-30,30)
    snowEmitter.LightEmission=0.1
    snowEmitter.EmissionDirection=Enum.NormalId.Bottom
    snowEmitter.Parent=snowPart
end

local function destroySnow()
    if snowEmitter then snowEmitter:Destroy() snowEmitter=nil end
    if snowPart then snowPart:Destroy() snowPart=nil end
end

RunService.RenderStepped:Connect(function()
    if C.Snow then
        if not snowEmitter then createSnow() end
        local cam=workspace.CurrentCamera
        snowPart.CFrame=CFrame.new(cam.CFrame.Position+Vector3.new(0,30,0))
        snowEmitter.Rate=C.SnowAmount
        snowEmitter.Speed=NumberRange.new(C.SnowSpeed*0.5,C.SnowSpeed)
        snowEmitter.Size=NumberSequence.new({
            NumberSequenceKeypoint.new(0,C.SnowSize),
            NumberSequenceKeypoint.new(1,C.SnowSize*0.5)
        })
        snowEmitter.Color=ColorSequence.new(C.SnowColor)
        if C.Blizzard then
            snowEmitter.SpreadAngle=Vector2.new(360,360)
            snowEmitter.Rate=C.SnowAmount*(C.BlizzardPower/30)
            snowEmitter.Speed=NumberRange.new(C.SnowSpeed*3,C.SnowSpeed*5)
        else
            snowEmitter.SpreadAngle=Vector2.new(180,180)
        end
    else
        if snowEmitter then destroySnow() end
    end
end)

