function PHANTOM.RegisterKeybinds()
    PHANTOM.Keybinds:Register("SilentAim", Enum.KeyCode.C, function(state)
        PHANTOM.Config.SilentAimEnabled = state
        PHANTOM.Runtime.SilentAimActive = state
        PHANTOM.Combat.Features.SilentAim.enabled = state
    end)

    PHANTOM.Keybinds:Register("VectorAim", Enum.KeyCode.V, function(state)
        PHANTOM.Runtime.VectorAimActive = state
        PHANTOM.Combat.Features.VectorAim.enabled = state
    end)

    PHANTOM.Keybinds:Register("Fly", Enum.KeyCode.F, function(state)
        PHANTOM.Player.Features.Fly.enabled = state
    end)
end

--=====================================================================
-- SECTION: PLAYER CONNECTIONS
--=====================================================================

function PHANTOM.SetupPlayerHooks()
    Services.Players.PlayerAdded:Connect(function(player)
        PHANTOM.Visuals:CreateESP(player)
    end)

    Services.Players.PlayerRemoving:Connect(function(player)
        PHANTOM.Visuals:DestroyESP(player)
    end)

    -- Существующие игроки
    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            PHANTOM.Visuals:CreateESP(player)
        end
    end
end

--=====================================================================
-- SECTION: MAIN UPDATE LOOP
--=====================================================================

function PHANTOM.StartRenderLoop()
    PHANTOM.Runtime.Connections.Render = Services.RunService.RenderStepped:Connect(function(dt)
        -- Aimbot
        pcall(function() PHANTOM.Aimbot:RunVectorAim() end)
        pcall(function() PHANTOM.Aimbot:DrawFOVCircle() end)

        -- Visuals
        pcall(function() PHANTOM.Visuals:RenderLoop() end)

        -- Player
        pcall(function() PHANTOM.Player:Update() end)

        -- Combat
        pcall(function() PHANTOM.Combat:Update() end)

        -- Misc
        pcall(function() PHANTOM.Misc:Update() end)
    end)
end

--=====================================================================
-- SECTION: UNLOAD
--=====================================================================

function PHANTOM.Unload()
    -- Отключаем все сигналы
    PHANTOM.DisconnectAll()

    -- Убираем ESP
    pcall(function() PHANTOM.Visuals:Cleanup() end)

    -- Убираем хуки
    pcall(function() PHANTOM.Hooks:UninstallAll() end)

    -- Удаляем UI
    if PHANTOM.UI.ScreenGui then
        pcall(function() PHANTOM.UI.ScreenGui:Destroy() end)
    end

    -- Убираем всплывающие тосты
    for _, gui in ipairs(Services.CoreGui:GetChildren()) do
        if gui.Name == "PhantomToast" or gui.Name == "PhantomToastHidden" then
            pcall(function() gui:Destroy() end)
        end
    end

    -- Сбрасываем Anchor/Noclip
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = true
                p.Anchored = false
            end
        end
    end

    PHANTOM.Runtime.Initialized = false
    PHANTOM.ShowToast("PHANTOM", "Скрипт выгружен", 3)
end

--=====================================================================
-- SECTION: BOOTSTRAP
--=====================================================================

function PHANTOM.Bootstrap()
    if PHANTOM.Runtime.Initialized then return end
    PHANTOM.Runtime.Initialized = true

    print("╔══════════════════════════════════════════════╗")
    print("║  PHANTOM HUB v" .. PHANTOM.Version .. " — запуск                     ║")
    print("╚══════════════════════════════════════════════╝")

    -- 1. Хуки (namecall для Silent Aim)
    if Drawing and Drawing.new then
        pcall(function() PHANTOM.Hooks:InstallNameCall() end)
    else
        warn("[Phantom] Drawing API недоступен — визуалы отключены.")
    end

    -- 2. Keybind система
    PHANTOM.Keybinds:Initialize()
    PHANTOM.RegisterKeybinds()

    -- 3. UI
    local window = PHANTOM.UI:CreateWindow({})
    if not window then
        warn("[Phantom] UI не создан.")
        return
    end

    PHANTOM.BuildCombatTab(window)
    PHANTOM.BuildVisualsTab(window)
    PHANTOM.BuildMiscTab(window)
    PHANTOM.BuildPlayerTab(window)
    PHANTOM.BuildInfoTab(window)
    PHANTOM.BuildSettingsTab(window)

    -- 4. RightShift hide
    PHANTOM.SetupInterfaceHide()

    -- 5. Player hooks (ESP при заходе игроков)
    PHANTOM.SetupPlayerHooks()

    -- 6. Render loop
    PHANTOM.StartRenderLoop()

    -- Финальное сообщение
    PHANTOM.ShowToast(
        "PHANTOM | Hub v" .. PHANTOM.Version,
        "Загружено · " .. PHANTOM.Info.Counters.Total .. " функций · Discord: " .. PHANTOM.Discord,
        4
    )

    local C = PHANTOM.Info.Counters
    print("[Phantom] Функций: " .. C.Total)
    print("[Phantom]   Visuals:  " .. C.Visuals .. " (ESP:" .. C.ESPPlayer ..
          " Chams:" .. C.Chams .. " Skel:" .. C.Skeleton ..
          " World:" .. C.WorldChams .. " Light:" .. C.Lighting ..
          " Screen:" .. C.Screen .. " WorldESP:" .. C.WorldESP ..
          " Debug:" .. C.MiscVisual .. ")")
    print("[Phantom]   Combat:   " .. C.Combat)
    print("[Phantom]   Misc:     " .. C.Misc)
    print("[Phantom]   Player:   " .. C.Player)
    print("[Phantom] Бинды: C=SilentAim  V=VectorAim  F=Fly  RightShift=HideUI")
    print("[Phantom] Discord: " .. PHANTOM.Discord)
    print("╔══════════════════════════════════════════════╗")
    print("║  Phantom Hub готов.                          ║")
    print("╚══════════════════════════════════════════════╝")
end

--=====================================================================
-- SECTION: AUTO-RUN
--=====================================================================

PHANTOM.Bootstrap()

-- Возвращаем объект для внешнего использования
return PHANTOM
