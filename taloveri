}

local function GetWritableMetaTable(instance)
    local ok, mt = pcall(getrawmetatable, instance)
    if not ok or not mt then return nil end
    pcall(setreadonly, mt, false)
    return mt
end

local function CreateHookClosure(fn)
    if newcclosure then return newcclosure(fn) end
    return fn
end

local function SafeHookMetaMethod(instance, method, hookFn)
    local ok, result = pcall(function()
        return hookmetamethod(instance, method, hookFn)
    end)
    if ok then return result end
    warn("[Phantom] hookmetamethod failed for " .. tostring(method))
    return nil
end

local function InstallNameCallHook()
    if HookRegistry.namecall.active then return true end
    local mt = GetWritableMetaTable(game)
    if not mt then return false end

    local oldNameCall = mt.__namecall
    HookRegistry.namecall.original = oldNameCall

    local hookedNameCall = CreateHookClosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if PHANTOM.Runtime.SilentAimActive and PHANTOM.Config.SilentAimEnabled then
            local target = PHANTOM.Aimbot:GetSilentTarget()
            if target and target.Character then
                local targetPart = target.Character:FindFirstChild(PHANTOM.Config.SilentAimPart)
                    or target.Character:FindFirstChild("Head")
                    or target.Character:FindFirstChild("HumanoidRootPart")

                if targetPart then
                    if method == "FireServer" and typeof(args[1]) == "Vector3" then
                        args[1] = PHANTOM.Aimbot:CalculatePrediction(targetPart)
                        return oldNameCall(self, unpack(args))
                    end

                    if method == "FindPartOnRayWithIgnoreList" or method == "Raycast" then
                        local cameraPos = Camera.CFrame.Position
                        local direction = (targetPart.Position - cameraPos).Unit
                        local newRay = Ray.new(cameraPos, direction * 1000)
                        for i, v in ipairs(args) do
                            if typeof(v) == "Ray" then
                                args[i] = newRay
                                break
                            end
                        end
                        return oldNameCall(self, unpack(args))
                    end
                end
            end
        end
        return oldNameCall(self, ...)
    end)

    mt.__namecall = hookedNameCall
    setreadonly(mt, true)
    HookRegistry.namecall.hooked = hookedNameCall
    HookRegistry.namecall.active = true
    return true
end
PHANTOM.Keybinds = {
    registry = {},
    held = {},
    Register = function(self, name, defaultKey, callback)
        self.registry[name] = { Name = name, Key = defaultKey, Callback = callback, Active = false }
        return self.registry[name]
    end,
    SetKey = function(self, name, keyCode)
        if self.registry[name] then self.registry[name].Key = keyCode end
    end,
    IsHeld = function(self, name)
        local bind = self.registry[name]
        if not bind then return false end
        return Services.UserInputService:IsKeyDown(bind.Key)
    end,
    Initialize = function(self)
        Services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            for _, bind in pairs(self.registry) do
                if input.KeyCode == bind.Key then
                    bind.Active = not bind.Active
                    if bind.Callback then pcall(bind.Callback, bind.Active) end
                end
            end
        end)
    end
}

PHANTOM.Aimbot = {
    FOV = 120,
    Smoothness = 0.15,
    Prediction = 0.135,
    TeamCheck = true,
    WallCheck = false,
    TargetPart = "HumanoidRootPart",
    SilentAimPart = "Head",

    GetClosestPlayer = function(self, useScreenSpace)
        local closestPlayer = nil
        local closestDistance = self.FOV
        local myCharacter = LocalPlayer.Character
        if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return nil end

        local cameraPos = Camera.CFrame.Position
        local mousePos = Services.UserInputService:GetMouseLocation()

        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if not player.Character then continue end

            local targetPart = player.Character:FindFirstChild(self.TargetPart)
            if not targetPart then continue end

            local humanoid = player.Character:FindFirstChild("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end

            if self.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end

            if self.WallCheck then
                local ray = Ray.new(cameraPos, (targetPart.Position - cameraPos).Unit * 1000)
                local hit = Services.Workspace:FindPartOnRay(ray, myCharacter)
                if hit and not hit:IsDescendantOf(player.Character) then continue end
            end

            local distance
            if useScreenSpace then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if not onScreen then continue end
                distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
            else
                distance = (targetPart.Position - cameraPos).Magnitude
            end

            if distance < closestDistance then
                closestDistance = distance
                closestPlayer = player
            end
        end
        return closestPlayer
    end,

    CalculatePrediction = function(self, part)
        if not part or not part.Parent then return Vector3.new() end
        local velocity = part.AssemblyLinearVelocity or part.Velocity or Vector3.new()
        return part.Position + (velocity * self.Prediction)
    end,

    GetSilentTarget = function(self)
        return self:GetClosestPlayer(true)
    end,

    RunVectorAim = function(self)
        if not PHANTOM.Runtime.VectorAimActive then return end
        local target = self:GetClosestPlayer(false)
        if not target or not target.Character then return end
        local targetPart = target.Character:FindFirstChild(self.TargetPart)
        if not targetPart then return end

        local predictedPos = self:CalculatePrediction(targetPart)
        local cameraPos = Camera.CFrame.Position
        local lookCFrame = CFrame.lookAt(cameraPos, predictedPos)
        Camera.CFrame = Camera.CFrame:Lerp(lookCFrame, self.Smoothness)
    end,

    DrawFOV = function(self)
        if not PHANTOM.Visuals.FOVCircle then
            local circle = Drawing.new("Circle")
            circle.Thickness = 1
            circle.NumSides = 64
            circle.Radius = self.FOV
            circle.Filled = false
            circle.Color = Color3.fromRGB(255, 255, 255)
            circle.Transparency = 0.8
            PHANTOM.Visuals.FOVCircle = circle
        end
        local circle = PHANTOM.Visuals.FOVCircle
        circle.Visible = PHANTOM.Config.ShowFOV
        if not circle.Visible then return end
        circle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        circle.Radius = self.FOV
    end
}
