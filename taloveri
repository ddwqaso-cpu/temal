local U = {}

function U.Round(n, decimals)
    local mult = 10 ^ (decimals or 0)
    return math.floor(n * mult + 0.5) / mult
end

function U.FormatNumber(n)
    if n >= 1e9 then return string.format("%.1fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
    return tostring(math.floor(n))
end

function U.FormatTime(seconds)
    local m = math.floor(seconds / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d", m, s)
end

function U.Lerp(a, b, t)
    return a + (b - a) * t
end

function U.Clamp(v, min, max)
    if v < min then return min end
    if v > max then return max end
    return v
end

function U.CopyTable(t)
    local copy = {}
    for k, v in pairs(t) do
        if type(v) == "table" then
            copy[k] = U.CopyTable(v)
        else
            copy[k] = v
        end
    end
    return copy
end

function U.MergeTable(t1, t2)
    local out = U.CopyTable(t1)
    for k, v in pairs(t2) do out[k] = v end
    return out
end

function U.DeepCompare(t1, t2)
    if type(t1) ~= type(t2) then return false end
    if type(t1) ~= "table" then return t1 == t2 end
    for k, v in pairs(t1) do
        if not U.DeepCompare(v, t2[k]) then return false end
    end
    for k in pairs(t2) do
        if t1[k] == nil then return false end
    end
    return true
end

function U.GetCharacter(player)
    if not player then return nil, nil, nil end
    local char = player.Character
    if not char then return nil, nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    return char, hum, root
end

function U.IsAlive(player)
    local char, hum = U.GetCharacter(player)
    return char ~= nil and hum ~= nil and hum.Health > 0
end

function U.GetDistance(p1, p2)
    if not p1 or not p2 then return math.huge end
    return (p1 - p2).Magnitude
end

function U.WorldToScreen(pos)
    return Camera:WorldToViewportPoint(pos)
end

function U.GetLocalCharacter()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

function U.SafeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[Phantom] SafeCall error: " .. tostring(err))
    end
    return ok
end

