--=====================================================================

function PHANTOM.Bootstrap()
    if PHANTOM.Runtime.Initialized then return end
    PHANTOM.Runtime.Initialized = true

    print("╔══════════════════════════════════════════════════╗")
    print("║  PHANTOM | " .. PHANTOM.Game .. " v" .. PHANTOM.Version .. " — запуск")
    print("╚══════════════════════════════════════════════════╝")

    -- 1. Drawing API check
    if not Drawing or not Drawing.new then
        warn("[Phantom] Drawing API недоступен — визуалы работать не будут.")
    end

    -- 2. Хуки (для Silent Aim)
    pcall(function() PHANTOM.Hooks:InstallNameCall() end)

    -- 3. Keybind система
    PHANTOM.Keybinds:Initialize()
    PHANTOM.RegisterKeybinds()

    -- 4. UI
    local window = UI:CreateWindow({})
    if not window then
        warn("[Phantom] UI не создан.")
        return
    end

    -- 5. Все вкладки
    PHANTOM.BuildCombatTab(window)
    PHANTOM.BuildVisualsTab(window)
    PHANTOM.BuildVisualsTab2(window)
    PHANTOM.BuildMovementTab(window)
    PHANTOM.BuildMiscTab(window)
    PHANTOM.BuildInfoTab(window)
    PHANTOM.BuildSettingsTab(window)

    -- 6. RightShift
    PHANTOM.SetupInterfaceHide()

    -- 7. Player hooks
    PHANTOM.SetupPlayerHooks()

    -- 8. Render loop
    PHANTOM.StartRenderLoop()

    -- Финальное сообщение
    PHANTOM.ShowToast(
        "PHANTOM | " .. PHANTOM.Game .. " v" .. PHANTOM.Version,
        "Загружено · " .. PHANTOM.Info.Counters.Total .. " функций · Discord скопирован по клику",
        4
    )

    local C = PHANTOM.Info.Counters
    print("[Phantom] Всего функций: " .. C.Total)
    print("[Phantom]   Combat:   " .. C.Combat)
    print("[Phantom]   Movement: " .. C.Movement)
    print("[Phantom]   Visuals:  " .. C.Visuals)
    print("[Phantom]     ESP:    " .. C.ESP)
    print("[Phantom]     Chams:  " .. C.Chams)
    print("[Phantom]     World:  " .. C.World)
    print("[Phantom]     Screen: " .. C.Screen)
    print("[Phantom]     Info:   " .. C.Info)
    print("[Phantom]     WESP:   " .. C.WorldESP)
    print("[Phantom]   Misc:     " .. C.Misc)
    print("[Phantom] Бинды: C=SilentAim V=VectorAim F=Fly Q=Dash Z=Phase RightShift=HideUI")
    print("[Phantom] Discord: " .. PHANTOM.Discord)
    print("╔══════════════════════════════════════════════════╗")
    print("║  Phantom Hub готов.                              ║")
    print("╚══════════════════════════════════════════════════╝")
end

