-- SECTION: INTERFACE HIDE HANDLER (RightShift)
--=====================================================================

local function SetupInterfaceHide()
    Services.UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            PHANTOM.Config.InterfaceHidden = not PHANTOM.Config.InterfaceHidden
            pcall(function()
                for _, gui in ipairs(Services.CoreGui:GetChildren()) do
                    if gui.Name:find("Orion") or gui.Name:find("Rayfield") then
                        gui.Enabled = not PHANTOM.Config.InterfaceHidden
                    end
                end
            end)
            if PHANTOM.Config.InterfaceHidden then
                -- Toast
                local sg = Instance.new("ScreenGui")
                sg.Name = "PhantomToastHidden"
                sg.IgnoreGuiInset = true
                sg.ResetOnSpawn = false
                pcall(function() sg.Parent = Services.CoreGui end)
                if not sg.Parent then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end

                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(0, 320, 0, 72)
                frame.Position = UDim2.new(0.5, -160, 1, -130)
                frame.BackgroundColor3 = Color3.fromRGB(28,28,34)
                frame.BorderSizePixel = 0
                frame.BackgroundTransparency = 1
                frame.Parent = sg

                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 12)
                corner.Parent = frame

                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.fromRGB(140,90,220)
                stroke.Thickness = 1
                stroke.Transparency = 1
                stroke.Parent = frame

                local icon = Instance.new("ImageLabel")
                icon.Size = UDim2.new(0, 32, 0, 32)
                icon.Position = UDim2.new(0, 18, 0.5, -16)
                icon.BackgroundTransparency = 1
                icon.Image = "rbxassetid://10723407367"
                icon.ImageColor3 = Color3.fromRGB(140,90,220)
                icon.ImageTransparency = 1
                icon.Parent = frame

                local title = Instance.new("TextLabel")
                title.Size = UDim2.new(1, -70, 0, 22)
                title.Position = UDim2.new(0, 62, 0, 15)
                title.BackgroundTransparency = 1
                title.Text = "Interface Hidden"
                title.TextColor3 = Color3.fromRGB(255,255,255)
                title.Font = Enum.Font.GothamBold
                title.TextSize = 15
                title.TextXAlignment = Enum.TextXAlignment.Left
                title.TextTransparency = 1
                title.Parent = frame

                local sub = Instance.new("TextLabel")
                sub.Size = UDim2.new(1, -70, 0, 20)
                sub.Position = UDim2.new(0, 62, 0, 38)
                sub.BackgroundTransparency = 1
                sub.Text = "Tap RightShift to reopen the interface"
                sub.TextColor3 = Color3.fromRGB(170,170,180)
                sub.Font = Enum.Font.Gotham
                sub.TextSize = 12
                sub.TextXAlignment = Enum.TextXAlignment.Left
                sub.TextTransparency = 1
                sub.Parent = frame

                local TS = Services.TweenService
                TS:Create(frame, TweenInfo.new(0.25), {BackgroundTransparency = 0}):Play()
                TS:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.4}):Play()
                TS:Create(icon, TweenInfo.new(0.25), {ImageTransparency = 0}):Play()
                TS:Create(title, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
                TS:Create(sub, TweenInfo.new(0.25), {TextTransparency = 0}):Play()

                task.delay(3, function()
                    TS:Create(frame, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
                    TS:Create(stroke, TweenInfo.new(0.35), {Transparency = 1}):Play()
                    TS:Create(icon, TweenInfo.new(0.35), {ImageTransparency = 1}):Play()
                    TS:Create(title, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
                    TS:Create(sub, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
                    task.wait(0.4)
                    pcall(function() sg:Destroy() end)
                end)
            end
        end
    end)
end

--=====================================================================
-- SECTION: BOOTSTRAP
--=====================================================================

local function Bootstrap()
    if PHANTOM.Runtime.Initialized then return end
    PHANTOM.Runtime.Initialized = true

    if Drawing and Drawing.new then
        pcall(InstallNameCallHook)
    end

    PHANTOM.Keybinds:Initialize()

    PHANTOM.Keybinds:Register("SilentAim", Enum.KeyCode.C, function(state)
        PHANTOM.Config.SilentAimEnabled = state
        PHANTOM.Runtime.SilentAimActive = state
    end)
    PHANTOM.Keybinds:Register("VectorAim", Enum.KeyCode.V, function(state)
        PHANTOM.Runtime.VectorAimActive = state
    end)
    PHANTOM.Keybinds:Register("Fly", Enum.KeyCode.F, function(state)
        PHANTOM.Player.Features.Fly.enabled = state
    end)

    pcall(SetupInterfaceHide)

    local uiOK = pcall(InitializeUI)
    if not uiOK then warn("[Phantom] UI failed to initialize.") end

    Services.RunService.RenderStepped:Connect(function()
        pcall(function()
            PHANTOM.Visuals:RenderLoop()
            PHANTOM.Aimbot:RunVectorAim()
            PHANTOM.Aimbot:DrawFOV()
            PHANTOM.Player:Update()
            PHANTOM.Combat:Update()
            PHANTOM.Misc:Update()
        end)
    end)

    print("========================================")
    print("[PHANTOM HUB v3.0] Успешно загружен.")
    print("[PHANTOM] Всего функций: " .. PHANTOM.Info.Counters.Total)
    print("[PHANTOM] Visuals: " .. PHANTOM.Info.Counters.Visuals
        .. " | Combat: " .. PHANTOM.Info.Counters.Combat
        .. " | Misc: " .. PHANTOM.Info.Counters.Misc)
    print("[PHANTOM] Discord: " .. PHANTOM.Config.DiscordURL)
    print("[PHANTOM] Бинды: C = Silent Aim, V = Vector Aim, F = Fly, RightShift = Hide UI")
    print("========================================")
end

Bootstrap()
