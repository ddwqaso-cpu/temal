PHANTOM.Movement = {
    Features = {
        SpeedHack   = { enabled = false, value = 16, mode = "Humanoid" },
        JumpPower   = { enabled = false, value = 50 },
        Fly         = { enabled = false, speed = 60, vertical = false },
        Noclip      = { enabled = false },
        InfiniteJump= { enabled = false, lastJump = 0 },
        BunnyHop    = { enabled = false, lastHop = 0 },
        Slide       = { enabled = false, speed = 100, duration = 0.6, lastSlide = 0 },
        WallClimb   = { enabled = false, speed = 30 },
        AirControl  = { enabled = false, force = 10 },
        Gravity     = { enabled = false, value = 196.2 },
        Dash        = { enabled = false, distance = 50, key = Enum.KeyCode.Q, lastDash = 0 },
        Phase       = { enabled = false, range = 25, key = Enum.KeyCode.Z, lastPhase = 0 },
        Freeze      = { enabled = false },
        Anchor      = { enabled = false },
        HideChar    = { enabled = false }
    },

    -- =========================================================
    -- UPDATE
    -- =========================================================
    Update = function(self)
        local char, hum, root = U.GetLocalCharacter()
        if not char then return end

        local F = self.Features
        local UIS = Services.UserInputService

        -- ===== SpeedHack =====
        if hum then
            if F.SpeedHack.enabled then
                hum.WalkSpeed = F.SpeedHack.value
            elseif not F.Slide.enabled then
                hum.WalkSpeed = 16
            end
        end

        -- ===== JumpPower =====
        if hum then
            if F.JumpPower.enabled then
                hum.UseJumpPower = true
                hum.JumpPower = F.JumpPower.value
            end
        end

        -- ===== Noclip =====
        if F.Noclip.enabled then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end

        -- ===== Infinite Jump =====
        if F.InfiniteJump.enabled and hum and root then
            if UIS:IsKeyDown(Enum.KeyCode.Space) and tick() - F.InfiniteJump.lastJump > 0.08 then
                hum.Jump = true
                F.InfiniteJump.lastJump = tick()
            end
        end

        -- ===== BunnyHop =====
        if F.BunnyHop.enabled and hum and root then
            if hum.FloorMaterial ~= Enum.Material.Air and UIS:IsKeyDown(Enum.KeyCode.Space) then
                if tick() - F.BunnyHop.lastHop > 0.05 then
                    hum.Jump = true
                    F.BunnyHop.lastHop = tick()
                end
            end
        end

        -- ===== Fly =====
        if F.Fly.enabled and root then
            local dir = Vector3.new()
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end

            if dir.Magnitude > 0 then
                root.AssemblyLinearVelocity = dir.Unit * F.Fly.speed
            else
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end

        -- ===== Slide (shift + space) =====
        if F.Slide.enabled and hum and root then
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) and UIS:IsKeyDown(Enum.KeyCode.Space) then
                if tick() - F.Slide.lastSlide > 1.2 then
                    local dir = hum.MoveDirection
                    if dir.Magnitude > 0 then
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(1e5, 0, 1e5)
                        bv.Velocity = dir.Unit * F.Slide.speed
                        bv.Parent = root
                        hum.WalkSpeed = 0
                        F.Slide.lastSlide = tick()
                        task.delay(F.Slide.duration, function()
                            if bv then bv:Destroy() end
                            if hum then hum.WalkSpeed = F.SpeedHack.enabled and F.SpeedHack.value or 16 end
                        end)
                    end
                end
            end
        end

        -- ===== WallClimb =====
        if F.WallClimb.enabled and hum and root then
            local ray = Ray.new(root.Position, root.CFrame.LookVector * 3)
            local hit = Services.Workspace:FindPartOnRayWithIgnoreList(ray, {char})
            if hit and UIS:IsKeyDown(Enum.KeyCode.W) then
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    F.WallClimb.speed,
                    root.AssemblyLinearVelocity.Z
                )
            end
        end

        -- ===== AirControl =====
        if F.AirControl.enabled and hum and root then
            if hum.FloorMaterial == Enum.Material.Air then
                local dir = hum.MoveDirection
                if dir.Magnitude > 0 then
                    root.AssemblyLinearVelocity = root.AssemblyLinearVelocity
                        + dir.Unit * F.AirControl.force * 0.1
                end
            end
        end

        -- ===== Gravity =====
        if F.Gravity.enabled then
            Services.Workspace.Gravity = F.Gravity.value
        else
            Services.Workspace.Gravity = 196.2
        end

        -- ===== Dash =====
        if F.Dash.enabled and root and UIS:IsKeyDown(F.Dash.key) then
            if tick() - F.Dash.lastDash > 0.8 then
                local dir = hum.MoveDirection
                if dir.Magnitude < 0.1 then dir = root.CFrame.LookVector end
                root.CFrame = root.CFrame + dir.Unit * F.Dash.distance
                F.Dash.lastDash = tick()
            end
        end

        -- ===== Phase (сквозь стены) =====
        if F.Phase.enabled and root and UIS:IsKeyDown(F.Phase.key) then
            if tick() - F.Phase.lastPhase > 0.5 then
                local dir = root.CFrame.LookVector
                root.CFrame = root.CFrame + dir * F.Phase.range
                F.Phase.lastPhase = tick()
            end
        end

        -- ===== Freeze =====
        if F.Freeze.enabled and hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end

        -- ===== Anchor =====
        if root then
            root.Anchored = F.Anchor.enabled
        end

        -- ===== HideChar =====
        if F.HideChar.enabled then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.LocalTransparencyModifier = 1
                end
            end
        else
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.LocalTransparencyModifier = 0
                end
            end
        end
    end
}

