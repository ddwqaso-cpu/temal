-- SECTION: DRAWING POOL
--=====================================================================

local DrawingPool = {
    pooled = {},
    acquired = {},

    Acquire = function(self, kind)
        self.pooled[kind] = self.pooled[kind] or {}
        local bucket = self.pooled[kind]
        local obj
        if #bucket > 0 then
            obj = table.remove(bucket)
            obj.Visible = false
        else
            obj = Drawing.new(kind)
            obj.Visible = false
        end
        table.insert(self.acquired, { kind = kind, obj = obj })
        return obj
    end,

    Release = function(self, kind, obj)
        if not obj then return end
        pcall(function() obj.Visible = false end)
        self.pooled[kind] = self.pooled[kind] or {}
        table.insert(self.pooled[kind], obj)
        -- Убираем из acquired
        for i = #self.acquired, 1, -1 do
            if self.acquired[i].obj == obj then
                table.remove(self.acquired, i)
                break
            end
        end
    end,

    DestroyAll = function(self)
        for _, entry in ipairs(self.acquired) do
            pcall(function() entry.obj:Remove() end)
        end
        for _, bucket in pairs(self.pooled) do
            for _, obj in ipairs(bucket) do
                pcall(function() obj:Remove() end)
            end
        end
        self.pooled = {}
        self.acquired = {}
    end
}

PHANTOM.DrawingPool = DrawingPool

