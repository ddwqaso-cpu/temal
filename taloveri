        Position = UDim2.new(0.6, 4, 0.5, -12),
        BackgroundColor3 = PHANTOM.Config.ElementColor,
        BorderSizePixel = 0,
        Text = tostring(currentKey.Name or currentKey),
        TextColor3 = PHANTOM.Config.TextColor,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        AutoButtonColor = false,
        Parent = frame
    })
    Corner(keyLabel, 4)

    local listening = false

    keyLabel.MouseButton1Click:Connect(function()
        listening = true
        keyLabel.Text = "..."
        keyLabel.TextColor3 = PHANTOM.Config.AccentColor
    end)

    local inputConn
    inputConn = Services.UserInputService.InputBegan:Connect(function(input, gp)
        if not listening then return end
        if gp then return end

        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            keyLabel.Text = input.KeyCode.Name
            keyLabel.TextColor3 = PHANTOM.Config.TextColor
            listening = false
            if callback then pcall(callback, input.KeyCode) end
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            currentKey = Enum.UserInputType.MouseButton1
            keyLabel.Text = "Mouse1"
            keyLabel.TextColor3 = PHANTOM.Config.TextColor
            listening = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            currentKey = Enum.UserInputType.MouseButton2
            keyLabel.Text = "Mouse2"
            keyLabel.TextColor3 = PHANTOM.Config.TextColor
            listening = false
        end
    end)

    return {
        Name = name,
        Flag = flag,
        Frame = frame,
        Get = function() return currentKey end,
        Set = function(v)
            currentKey = v
            keyLabel.Text = tostring(v.Name or v)
            if callback then pcall(callback, v) end
        end
    }
end

