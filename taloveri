-- SECTION: METATABLE HOOK SYSTEM (BYPASS-SAFE)
--=====================================================================

PHANTOM.Hooks = {
    Registry = {
        namecall = { original = nil, hooked = nil, active = false },
        index    = { original = nil, hooked = nil, active = false },
        newindex = { original = nil, hooked = nil, active = false }
    },

    GetWritableMetaTable = function(self, instance)
        local ok, mt = pcall(getrawmetatable, instance)
        if not ok or not mt then return nil end
        pcall(setreadonly, mt, false)
        return mt
    end,

    CreateClosure = function(self, fn)
        if newcclosure then return newcclosure(fn) end
        return fn
    end,

    InstallNameCall = function(self)
        if self.Registry.namecall.active then return true end
        local mt = self:GetWritableMetaTable(game)
        if not mt then return false end

        local oldNameCall = mt.__namecall
        self.Registry.namecall.original = oldNameCall

        local hooked = self:CreateClosure(function(self_, ...)
            local method = getnamecallmethod()
            local args = {...}

            if PHANTOM.Runtime.SilentAimActive and PHANTOM.Config.SilentAimEnabled then
                local target = PHANTOM.Aimbot:GetSilentTarget()
                if target and target.Character then
                    local tp = target.Character:FindFirstChild(PHANTOM.Config.SilentAimPart)
                        or target.Character:FindFirstChild("Head")
                        or target.Character:FindFirstChild("HumanoidRootPart")

                    if tp then
                        if method == "FireServer" and typeof(args[1]) == "Vector3" then
                            args[1] = PHANTOM.Aimbot:CalculatePrediction(tp)
                            return oldNameCall(self_, unpack(args))
                        end

                        if method == "FindPartOnRayWithIgnoreList" or method == "Raycast" then
                            local camPos = Camera.CFrame.Position
                            local dir = (tp.Position - camPos).Unit
                            for i, v in ipairs(args) do
                                if typeof(v) == "Ray" then
                                    args[i] = Ray.new(camPos, dir * 1000)
                                    break
                                end
                            end
                            return oldNameCall(self_, unpack(args))
                        end
                    end
                end
            end
            return oldNameCall(self_, ...)
        end)

        mt.__namecall = hooked
        setreadonly(mt, true)
        self.Registry.namecall.hooked = hooked
        self.Registry.namecall.active = true
        return true
    end,

    UninstallAll = function(self)
        local mt = self:GetWritableMetaTable(game)
        if not mt then return end
        if self.Registry.namecall.original then
            mt.__namecall = self.Registry.namecall.original
            self.Registry.namecall.active = false
        end
        setreadonly(mt, true)
    end
}
