            Services.TweenService:Create(box, TweenInfo.new(0.15),
                {BackgroundColor3 = v and PHANTOM.Config.AccentColor or PHANTOM.Config.ElementColor}):Play()
            Services.TweenService:Create(stroke, TweenInfo.new(0.15),
