--=====================================================================

PHANTOM.Visuals.Cleanup = function(self)
    for player, _ in pairs(self.ESPRegistry) do
        self:DestroyESP(player)
    end
    self.ESPRegistry = {}

    if self.FOVCircle then
        pcall(function() self.FOVCircle:Remove() end)
        self.FOVCircle = nil
    end

    local S = self._ScreenState
    for _, l in pairs(S.Crosshair) do pcall(function() l:Remove() end) end
    for _, l in pairs(S.Hitmarker) do pcall(function() l:Remove() end) end
    if S.Vignette then pcall(function() S.Vignette:Destroy() end) end
    if S.BarsTop then pcall(function() S.BarsTop:Destroy() end) end
    if S.BarsBottom then pcall(function() S.BarsBottom:Destroy() end) end
    if S.Damage then pcall(function() S.Damage:Destroy() end) end

    self._ScreenState = {
        Crosshair = {}, Hitmarker = { Expire = 0 }
    }

    PHANTOM.DrawingPool:DestroyAll()

    -- Lighting reset
    local L = Services.Lighting
    local O = self._LightingOriginal
    L.Brightness = O.Brightness
    L.ClockTime = O.ClockTime
    L.GlobalShadows = O.GlobalShadows
    L.FogEnd = O.FogEnd
    L.FogStart = O.FogStart
    L.Ambient = O.Ambient
    L.OutdoorAmbient = O.OutdoorAmbient
    for _, name in ipairs({"PhantomCC","PhantomBloom"}) do
        local o = L:FindFirstChild(name)
        if o then o:Destroy() end
    end
end
