PHANTOM.Combat = {
    Features = {
        -- [1-5] AIM
        SilentAim       = { enabled = false },
        VectorAim       = { enabled = false },
        StickyAim       = { enabled = false, lockTime = 1.5 },
        Prediction      = { enabled = true,  value = 0.135 },
        Smoothness      = { enabled = true,  value = 0.15 },

        -- [6-15] WEAPON
        NoRecoil        = { enabled = false },
        NoSpread        = { enabled = false },
        RapidFire       = { enabled = false, rate = 0.02, lastFire = 0 },
        InstantHit      = { enabled = false },
        InfiniteAmmo    = { enabled = false },
        AutoReload      = { enabled = false, lastReload = 0 },
        AutoSwitch      = { enabled = false },
        AutoParry       = { enabled = false },
        AutoBlock       = { enabled = false, range = 15 },
        NoFlinch        = { enabled = false },

        -- [16-23] HITBOX / MELEE
        KillAura        = { enabled = false, range = 20, speed = 0.1, lastHit = 0 },
        HitboxExpander  = { enabled = false, size = 5, savedSizes = {} },
        HeadshotMode    = { enabled = false },
        DamageMultiplier= { enabled = false, value = 2 },
        CriticalHit     = { enabled = false },
        AutoCounter     = { enabled = false, range = 15 },
        AutoRetaliate   = { enabled = false, range = 25 },
        PerfectTiming   = { enabled = false },

        -- [24-30] AUTO
        AutoFire        = { enabled = false, range = 200, lastFire = 0 },
        TriggerBot      = { enabled = false, delay = 0.05, lastFire = 0 },
        AutoDodge       = { enabled = false, chance = 100 },
        DodgeRoll       = { enabled = false, cooldown = 1, lastRoll = 0 },
        AutoHeal        = { enabled = false, threshold = 30, lastHeal = 0 },
        AntiStun        = { enabled = false },
        AntiFlinch      = { enabled = false }
    },

    -- =========================================================
    -- UPDATE
    -- =========================================================
    Update = function(self)
        local char, hum, root = U.GetLocalCharacter()
        if not char then return end

        local F = self.Features
        local now = tick()

        -- ===== NoRecoil =====
        if F.NoRecoil.enabled and Camera then
            -- Обнуляем recoil через модуляцию свойств камеры
            if Camera.GetPropertyChangedSignal then
                -- Arsenal использует внутренний recoil в Camera.CFrame, здесь просто стабилизируем
                local cf = Camera.CFrame
                local currentRot = cf - cf.Position
                -- Сбрасываем накопленный pitch/yaw постепенно
                Camera.CFrame = CFrame.new(cf.Position) * currentRot
            end
        end

        -- ===== NoSpread =====
        if F.NoSpread.enabled then
            -- Обнуляем разброс через внутренние атрибуты Arsenal
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    pcall(function()
                        tool:SetAttribute("Spread", 0)
                        tool:SetAttribute("BulletSpread", 0)
                    end)
                end
            end
        end

        -- ===== RapidFire =====
        if F.RapidFire.enabled and now - F.RapidFire.lastFire > F.RapidFire.rate then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function() tool:Activate() end)
                F.RapidFire.lastFire = now
            end
        end

        -- ===== InstantHit =====
        if F.InstantHit.enabled then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    pcall(function()
                        tool:SetAttribute("BulletSpeed", 9999)
                        tool:SetAttribute("InstantHit", true)
                    end)
                end
            end
        end

        -- ===== InfiniteAmmo =====
        if F.InfiniteAmmo.enabled then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    pcall(function()
                        tool:SetAttribute("Ammo", 999)
                        tool:SetAttribute("InfiniteAmmo", true)
                    end)
                end
            end
        end

        -- ===== AutoReload =====
        if F.AutoReload.enabled and now - F.AutoReload.lastReload > 0.1 then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                local ammo = tool:GetAttribute("Ammo")
                local maxAmmo = tool:GetAttribute("MaxAmmo")
                if ammo and maxAmmo and ammo < maxAmmo then
                    pcall(function() tool:Activate() end)
                    F.AutoReload.lastReload = now
                end
            end
        end

        -- ===== AutoFire =====
        if F.AutoFire.enabled and now - F.AutoFire.lastFire > 0.05 then
            local target = PHANTOM.Aimbot:GetClosestPlayer(true)
            if target then
                pcall(function()
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                end)
                F.AutoFire.lastFire = now
            end
        end

        -- ===== TriggerBot =====
        if F.TriggerBot.enabled and now - F.TriggerBot.lastFire > F.TriggerBot.delay then
            local target = PHANTOM.Aimbot:GetClosestPlayer(true)
            if target and mousemoverel and mouse1click then
                pcall(function()
                    mousemoverel(0, 0)
                    mouse1click()
                end)
                F.TriggerBot.lastFire = now
            end
        end

        -- ===== KillAura =====
        if F.KillAura.enabled and now - F.KillAura.lastHit > F.KillAura.speed then
            for _, player in ipairs(Services.Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local c, h, r = U.GetCharacter(player)
                if c and r and root then
                    local d = (r.Position - root.Position).Magnitude
                    if d <= F.KillAura.range then
                        pcall(function()
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then tool:Activate() end
                        end)
                        F.KillAura.lastHit = now
                        break
                    end
                end
            end
        end

        -- ===== HitboxExpander =====
        if F.HitboxExpander.enabled then
            for _, player in ipairs(Services.Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local c = player.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if r then
                    if not F.HitboxExpander.savedSizes[player] then
                        F.HitboxExpander.savedSizes[player] = r.Size
                    end
                    r.Size = Vector3.new(F.HitboxExpander.size, F.HitboxExpander.size, F.HitboxExpander.size)
                    r.Transparency = 0.7
                    r.CanCollide = false
                end
            end
        else
            for player, size in pairs(F.HitboxExpander.savedSizes) do
                if player and player.Parent then
                    local c = player.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    if r then
                        r.Size = size
                        r.Transparency = 1
                    end
                end
            end
        end

        -- ===== AutoHeal =====
        if F.AutoHeal.enabled and hum and now - F.AutoHeal.lastHeal > 0.5 then
            if hum.Health < F.AutoHeal.threshold then
                pcall(function()
                    local heal = char:FindFirstChild("HealTool") or char:FindFirstChildOfClass("Tool")
                    if heal then heal:Activate() end
                end)
                F.AutoHeal.lastHeal = now
            end
        end

        -- ===== AntiFlinch / AntiStun =====
        if F.AntiFlinch.enabled and hum then hum.PlatformStand = false end
        if F.AntiStun.enabled and hum then hum.PlatformStand = false end

        -- ===== StickyAim =====
        if F.StickyAim.enabled and PHANTOM.Aimbot.StickyTarget then
            PHANTOM.Aimbot.StickyExpire = now + F.StickyAim.lockTime
        end

        -- ===== Prediction / Smoothness (sync with Aimbot) =====
        if F.Prediction.enabled then PHANTOM.Aimbot.Prediction = F.Prediction.value end
        if F.Smoothness.enabled then PHANTOM.Aimbot.Smoothness = F.Smoothness.value end
    end
}

