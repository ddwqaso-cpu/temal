        Text = name,
        TextColor3 = PHANTOM.Config.TextColor,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame
    })

    local swatch = New("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -52, 0.5, -10),
        BackgroundColor3 = default,
        BorderSizePixel = 0,
        Parent = frame
    })
    Corner(swatch, 4)
    Stroke(swatch, Color3.fromRGB(80,80,90), 1, 0)

    -- Простой цикл по Hue (без полноценного HSV-пикера)
    local hue = 0
    local btn = New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame
    })

    local cycling = false

    btn.MouseButton1Down:Connect(function()
        cycling = true
        local startTime = tick()
        task.spawn(function()
            while cycling and tick() - startTime < 5 do
                hue = (tick() * 0.4) % 1
                current = Color3.fromHSV(hue, 1, 1)
                swatch.BackgroundColor3 = current
                if callback then pcall(callback, current) end
                task.wait(0.05)
            end
            cycling = false
        end)
    end)

    btn.MouseButton1Up:Connect(function() cycling = false end)

    return {
        Name = name,
        Flag = flag,
        Frame = frame,
        Get = function() return current end,
        Set = function(v)
            current = v
            swatch.BackgroundColor3 = v
            if callback then pcall(callback, v) end
        end
    }
end

