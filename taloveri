PHANTOM.Aimbot = {
    FOV = 120,
    Smoothness = 0.15,
    Prediction = 0.135,
    TeamCheck = true,
    WallCheck = false,
    TargetPart = "HumanoidRootPart",
    SilentAimPart = "Head",
    PriorityMode = "Distance", -- "Distance" | "Health" | "Threat"
    StickyTarget = nil,
    StickyExpire = 0,

    -- Получение ближайшего игрока в радиусе FOV
    GetClosestPlayer = function(self, useScreenSpace)
        local closest, closestDist = nil, self.FOV or math.huge
        local myChar, myHum, myRoot = U.GetLocalCharacter()
        if not myChar or not myRoot then return nil end

        local camPos = Camera.CFrame.Position
        local mousePos = Services.UserInputService:GetMouseLocation()

        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player == LocalPlayer then continue end

            local char, hum, root = U.GetCharacter(player)
            if not char or not hum or hum.Health <= 0 then continue end

            local targetPart = char:FindFirstChild(self.TargetPart)
            if not targetPart then continue end

            -- Team check
            if self.TeamCheck and player.Team and LocalPlayer.Team
               and player.Team == LocalPlayer.Team then
                continue
            end

            -- Wall check
            if self.WallCheck then
                local ray = Ray.new(camPos, (targetPart.Position - camPos).Unit * 1000)
                local hit = Services.Workspace:FindPartOnRayWithIgnoreList(ray, {myChar})
                if hit and not hit:IsDescendantOf(char) then continue end
            end

            -- Distance calculation
            local distance
            if useScreenSpace then
                local sp, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if not onScreen then continue end
                distance = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
            else
                distance = (targetPart.Position - camPos).Magnitude
            end

            if distance < closestDist then
                closestDist = distance
                closest = player
            end
        end

        return closest
    end,

    -- Учёт движения для предсказания
    CalculatePrediction = function(self, part)
        if not part or not part.Parent then return Vector3.new() end
        local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.new()
        return part.Position + (vel * self.Prediction)
    end,

    -- Silent aim target (по экранным координатам от курсора)
    GetSilentTarget = function(self)
        -- Sticky logic
        if self.StickyTarget and tick() < self.StickyExpire then
            if U.IsAlive(self.StickyTarget) then
                return self.StickyTarget
            end
        end

        local target = self:GetClosestPlayer(true)
        if target then
            self.StickyTarget = target
            self.StickyExpire = tick() + 0.5
        end
        return target
    end,

    -- Vector aim — плавное вращение камеры
    RunVectorAim = function(self)
        if not PHANTOM.Runtime.VectorAimActive then return end

        local target = self:GetClosestPlayer(false)
        if not target then return end

        local char = target.Character
        if not char then return end

        local tp = char:FindFirstChild(self.TargetPart)
        if not tp then return end

        local predicted = self:CalculatePrediction(tp)
        local camPos = Camera.CFrame.Position
        local lookCF = CFrame.lookAt(camPos, predicted)
        Camera.CFrame = Camera.CFrame:Lerp(lookCF, self.Smoothness)
    end,

    -- FOV circle drawing
    DrawFOVCircle = function(self)
        if not PHANTOM.Visuals.FOVCircle then
            local c = Drawing.new("Circle")
            c.NumSides = 64
            c.Filled = false
            c.Thickness = 1
            c.Transparency = 0.85
            PHANTOM.Visuals.FOVCircle = c
        end
        local c = PHANTOM.Visuals.FOVCircle
        c.Visible = PHANTOM.Config.ShowFOV
        if c.Visible then
            c.Color = PHANTOM.Config.AccentColor
            c.Radius = self.FOV
            c.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        end
    end
}
