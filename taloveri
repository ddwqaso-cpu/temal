        Parent = frame
    })

    -- Список опций (появляется поверх)
    local listFrame = New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 1, 4),
        BackgroundColor3 = PHANTOM.Config.ElementColor,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = PHANTOM.Config.AccentColor,
        Visible = false,
        ZIndex = 10,
        Parent = frame
    })
    Corner(listFrame, 6)
    Stroke(listFrame, PHANTOM.Config.AccentColor, 1, 0.4)

    local listLayout = New("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = listFrame
    })
    Padding(listFrame, 4)

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        listFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
    end)

    local optionButtons = {}

    local function setValue(v, fireCallback)
        current = v
        currentLabel.Text = v
        for opt, btn in pairs(optionButtons) do
            btn.TextColor3 = (opt == v) and PHANTOM.Config.AccentColor or PHANTOM.Config.TextColor
        end
        if fireCallback ~= false and callback then pcall(callback, v) end
    end

    for _, opt in ipairs(options) do
        local optBtn = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = PHANTOM.Config.ElementColor,
            BorderSizePixel = 0,
            Text = "  " .. tostring(opt),
            TextColor3 = Color3.fromRGB(220,220,225),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            Parent = listFrame
        })
        Corner(optBtn, 4)
        optionButtons[opt] = optBtn

        optBtn.MouseButton1Click:Connect(function()
            setValue(opt)
            isOpen = false
            listFrame.Visible = false
            listFrame.Size = UDim2.new(1, 0, 0, 0)
        end)
    end

    local toggleBtn = New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame
    })

    toggleBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            listFrame.Visible = true
            local targetH = math.min(#options * 30, 150)
            Services.TweenService:Create(listFrame, TweenInfo.new(0.15),
                {Size = UDim2.new(1, 0, 0, targetH)}):Play()
        else
            Services.TweenService:Create(listFrame, TweenInfo.new(0.15),
                {Size = UDim2.new(1, 0, 0, 0)}):Play()
            task.delay(0.16, function() listFrame.Visible = false end)
        end
    end)

    setValue(current, false)

    return {
        Name = name,
        Flag = flag,
        Frame = frame,
        Get = function() return current end,
        Set = function(v) setValue(v) end
    }
end

