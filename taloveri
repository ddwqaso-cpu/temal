function PHANTOM.RegisterKeybinds()
    PHANTOM.Keybinds:Register("SilentAim", Enum.KeyCode.C, function(state)
        PHANTOM.Config.SilentAimEnabled = state
        PHANTOM.Runtime.SilentAimActive = state
        PHANTOM.Combat.Features.SilentAim.enabled = state
    end)

    PHANTOM.Keybinds:Register("VectorAim", Enum.KeyCode.V, function(state)
        PHANTOM.Runtime.VectorAimActive = state
        PHANTOM.Combat.Features.VectorAim.enabled = state
    end)

    PHANTOM.Keybinds:Register("Fly", Enum.KeyCode.F, function(state)
        PHANTOM.Movement.Features.Fly.enabled = state
    end)

    PHANTOM.Keybinds:Register("Dash", Enum.KeyCode.Q, function(state)
        if state and PHANTOM.Movement.Features.Dash.enabled then
            local _, _, root = U.GetLocalCharacter()
            if root then
                local dir = Camera.CFrame.LookVector
                root.CFrame = root.CFrame + dir * PHANTOM.Movement.Features.Dash.distance
            end
        end
    end, "Hold")

    PHANTOM.Keybinds:Register("Phase", Enum.KeyCode.Z, function(state)
        if state and PHANTOM.Movement.Features.Phase.enabled then
            local _, _, root = U.GetLocalCharacter()
            if root then
                local dir = root.CFrame.LookVector
                root.CFrame = root.CFrame + dir * PHANTOM.Movement.Features.Phase.range
            end
        end
    end, "Hold")
end

