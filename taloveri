        {name = "Ping", value = math.floor(LocalPlayer:GetNetworkPing() * 1000) .. " ms", enabled = Slots.PingDisplay.enabled},
        {name = "Mem", value = string.format("%.0f MB", Services.Stats:GetTotalMemoryUsageMb()), enabled = Slots.MemoryUsage.enabled},
        {name = "Ent", value = #Services.Workspace:GetChildren() .. " obj", enabled = Slots.EntityCount.enabled},
        {name = "Draw", value = #Services.Workspace:GetChildren() .. " calls", enabled = Slots.DrawCallCount.enabled},
        {name = "Hook", value = PHANTOM.Hooks.Registry.namecall.active and "active" or "off", enabled = Slots.HookStatus.enabled}
    }

    local _, _, lroot = U.GetLocalCharacter()
    if lroot then
        table.insert(items, {name = "Pos", value = string.format("%.0f, %.0f, %.0f",
            lroot.Position.X, lroot.Position.Y, lroot.Position.Z), enabled = Slots.PositionInfo.enabled})
        table.insert(items, {name = "Vel", value = string.format("%.0f",
            lroot.AssemblyLinearVelocity.Magnitude), enabled = Slots.VelocityInfo.enabled})
    end

    local y = 20
    for i, item in ipairs(items) do
        local key = "Info_" .. item.name
        if not self._InfoDrawings[key] then
            local t = Drawing.new("Text")
            t.Size = 14
            t.Outline = true
            t.Color = Color3.fromRGB(255, 255, 255)
            t.Font = 2
            self._InfoDrawings[key] = t
        end
        local t = self._InfoDrawings[key]
        t.Visible = item.enabled
        if item.enabled then
            t.Text = item.name .. ": " .. item.value
            t.Position = Vector2.new(10, y)
            y = y + 18
        end
    end
end

