PHANTOM.Visuals.UpdateChams = function(self, player, reg)
    local S = self.Slots
    if not S.ChamsEnabled.enabled then
        if reg and reg.Chams.Highlight then self:DestroyChams(player) end
        return
    end

    local char = player.Character
    if not char then
        if reg and reg.Chams.Highlight then self:DestroyChams(player) end
        return
    end

    self:CreateChams(player)
    local h = reg.Chams.Highlight
    if not h then return end

    local isTeammate = player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team

    local col
    if player == LocalPlayer and S.SelfChams.enabled then
        col = S.SelfChams.color
    elseif isTeammate and S.TeamChams.enabled then
        col = S.TeamChams.color
    elseif S.EnemyChams.enabled then
        col = S.EnemyChams.color
    else
        col = S.EnemyChams.color
    end

    h.FillColor = col
    h.FillTransparency = 0.5
    h.OutlineColor = col
    h.OutlineTransparency = 0
    h.DepthMode = S.ChamsXRay.enabled
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded
end
