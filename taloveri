PHANTOM.Keybinds = {
    registry = {},
    Register = function(self, name, defaultKey, callback, mode)
        self.registry[name] = {
            Name = name, Key = defaultKey, Callback = callback,
            Mode = mode or "Toggle", Active = false
        }
        return self.registry[name]
    end,
    SetKey = function(self, name, keyCode)
        if self.registry[name] then self.registry[name].Key = keyCode end
    end,
    IsHeld = function(self, name)
        local bind = self.registry[name]
        if not bind then return false end
        return Services.UserInputService:IsKeyDown(bind.Key)
    end,
    Initialize = function(self)
        Services.UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            for _, bind in pairs(self.registry) do
                if input.KeyCode == bind.Key then
                    if bind.Mode == "Toggle" then
                        bind.Active = not bind.Active
                    elseif bind.Mode == "Hold" then
                        bind.Active = true
                    end
                    if bind.Callback then pcall(bind.Callback, bind.Active) end
                end
            end
        end)
        Services.UserInputService.InputEnded:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            for _, bind in pairs(self.registry) do
                if input.KeyCode == bind.Key and bind.Mode == "Hold" then
                    bind.Active = false
                    if bind.Callback then pcall(bind.Callback, false) end
                end
            end
        end)
    end
}
