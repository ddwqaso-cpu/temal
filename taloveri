    end,
    
    --// Updates all ESP elements for a single player
    UpdateESP = function(self, player, registry)
        local character = player.Character
        if not character then
            for _, group in pairs(registry) do
                for _, obj in pairs(group) do
                    if obj and obj.Remove then obj.Visible = false end
                end
            end
            return
        end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        local humanoid = character:FindFirstChild("Humanoid")
        
        if not rootPart or not head or not humanoid or humanoid.Health <= 0 then
            for _, group in pairs(registry) do
                for _, obj in pairs(group) do
                    if obj and obj.Remove then obj.Visible = false end
                end
            end
            return
        end
        
        --// Screen projection
        local rootPos, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
        
        if not rootOnScreen or not headOnScreen or not bottomOnScreen then
            for _, group in pairs(registry) do
                for _, obj in pairs(group) do
                    if obj and obj.Remove then obj.Visible = false end
                end
            end
            return
        end
        
        local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
        
        --// Team color
        local espColor = Color3.fromRGB(255,255,255)
        if player.Team and LocalPlayer.Team then
            if player.Team == LocalPlayer.Team then
                espColor = Color3.fromRGB(0,255,0)
            else
                espColor = Color3.fromRGB(255,0,0)
            end
        end
        
        --// Box dimensions
        local boxHeight = math.abs(headPos.Y - bottomPos.Y)
        local boxWidth = boxHeight * 0.6
        local boxTopLeft = Vector2.new(rootPos.X - boxWidth/2, headPos.Y)
        local boxTopRight = Vector2.new(rootPos.X + boxWidth/2, headPos.Y)
        local boxBottomLeft = Vector2.new(rootPos.X - boxWidth/2, bottomPos.Y)
        local boxBottomRight = Vector2.new(rootPos.X + boxWidth/2, bottomPos.Y)
        
        --// Update Box
        local boxSlot = self.Slots.Box
        if boxSlot.enabled then
            registry.Box.Outline.Visible = true
            registry.Box.Outline.PointA = boxTopLeft
            registry.Box.Outline.PointB = boxTopRight
            registry.Box.Outline.PointC = boxBottomRight
            registry.Box.Outline.PointD = boxBottomLeft
            
            registry.Box.Main.Visible = true
            registry.Box.Main.PointA = boxTopLeft
            registry.Box.Main.PointB = boxTopRight
            registry.Box.Main.PointC = boxBottomRight
            registry.Box.Main.PointD = boxBottomLeft
            registry.Box.Main.Color = espColor
            registry.Box.Main.Thickness = boxSlot.thickness
        else
            registry.Box.Outline.Visible = false
            registry.Box.Main.Visible = false
        end
        
        --// Update Tracer
        if self.Slots.Tracer.enabled then
            registry.Tracer.Line.Visible = true
            registry.Tracer.Line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            registry.Tracer.Line.To = Vector2.new(rootPos.X, bottomPos.Y)
            registry.Tracer.Line.Color = espColor
            registry.Tracer.Line.Thickness = self.Slots.Tracer.thickness
        else
            registry.Tracer.Line.Visible = false
        end
        
        --// Update Head Dot
        if self.Slots.HeadDot.enabled then
            registry.HeadDot.Circle.Visible = true
            registry.HeadDot.Circle.Position = Vector2.new(headPos.X, headPos.Y)
            registry.HeadDot.Circle.Color = espColor
        else
            registry.HeadDot.Circle.Visible = false
        end
        
        --// Update Name
        if self.Slots.Name.enabled then
            registry.Name.Text.Visible = true
            registry.Name.Text.Position = Vector2.new(rootPos.X, headPos.Y - 18)
            registry.Name.Text.Text = player.Name
            registry.Name.Text.Color = self.Slots.Name.color
        else
            registry.Name.Text.Visible = false
        end
        
        --// Update Health Bar
        if self.Slots.HealthBar.enabled then
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            local barX = rootPos.X + boxWidth/2 + 6
            local barTop = headPos.Y
            local barBottom = headPos.Y + (boxHeight * healthPercent)
            
            registry.HealthBar.Background.Visible = true
            registry.HealthBar.Background.From = Vector2.new(barX, headPos.Y)
            registry.HealthBar.Background.To = Vector2.new(barX, bottomPos.Y)
            
            registry.HealthBar.Fill.Visible = true
            registry.HealthBar.Fill.From = Vector2.new(barX, headPos.Y)
            registry.HealthBar.Fill.To = Vector2.new(barX, barBottom)
            registry.HealthBar.Fill.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
        else
            registry.HealthBar.Background.Visible = false
            registry.HealthBar.Fill.Visible = false
        end
    end,
    
    --// Main render loop
    RenderLoop = function(self)
        --// FOV Circle
        PHANTOM.Aimbot:DrawFOV()
        
        --// ESP for all players
        if self.Slots.Box.enabled or self.Slots.Tracer.enabled or self.Slots.HeadDot.enabled 
           or self.Slots.Name.enabled or self.Slots.HealthBar.enabled then
            for _, player in ipairs(Services.Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                if not self.ESPRegistry[player] then
                    self:CreateESP(player)
                end
                if self.ESPRegistry[player] then
                    self:UpdateESP(player, self.ESPRegistry[player])
                end
            end
        end
    end,
    
    --// Cleanup
    Cleanup = function(self)
        for player, registry in pairs(self.ESPRegistry) do
            for _, group in pairs(registry) do
                for _, obj in pairs(group) do
                    if obj and obj.Remove then
                        pcall(function() obj:Remove() end)
                    end
                end
            end
        end
        self.ESPRegistry = {}
        
        if self.FOVCircle then
            self.FOVCircle:Remove()
            self.FOVCircle = nil
        end
    end
}

