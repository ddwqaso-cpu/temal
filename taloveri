--=====================================================================
-- SECTION: UPDATE ESP (main per-player update)
--=====================================================================

PHANTOM.Visuals.UpdateESP = function(self, player, reg)
    local char, hum, root = U.GetCharacter(player)

    local function hideAll()
        for _, items in pairs(reg) do
            if type(items) == "table" then
                for _, obj in pairs(items) do
                    if type(obj) == "userdata" and obj.Visible ~= nil then obj.Visible = false end
                end
            elseif type(items) == "userdata" and items.Visible ~= nil then
                items.Visible = false
            end
        end
    end

    if not char or not hum or hum.Health <= 0 or not root then hideAll() return end

    local S = self.Slots
    local camPos = Camera.CFrame.Position
    local dist = (camPos - root.Position).Magnitude

    -- MaxDistance filter
    if S.MaxDistance.enabled and dist > S.MaxDistance.value then hideAll() return end

    -- Team check
    local isTeammate = player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team
    if S.TeamCheck.enabled and isTeammate then hideAll() return end

    -- Head + bottom для расчёта бокса
    local head = char:FindFirstChild("Head")
    if not head then hideAll() return end

    -- Visible only
    if S.VisibleOnly.enabled then
        local ray = Ray.new(camPos, (head.Position - camPos).Unit * dist)
        local hit = Services.Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, char})
        if hit and not hit:IsDescendantOf(char) and hit.Transparency < 0.9 then
            hideAll() return
        end
    end

    -- Screen projection
    local rootPos, rootOn = Camera:WorldToViewportPoint(root.Position)
    local headPos, headOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local bottomPos, bottomOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
    if not rootOn or not headOn or not bottomOn then hideAll() return end

    -- Цвет по команде
    local col = S.OutlineColor.color
    if isTeammate then col = Color3.fromRGB(0,255,100)
    elseif player.Team then col = Color3.fromRGB(255,80,80) end

    -- Box geometry
    local boxH = math.abs(headPos.Y - bottomPos.Y)
    local boxW = boxH * 0.55
    local TL = Vector2.new(rootPos.X - boxW/2, headPos.Y)
    local TR = Vector2.new(rootPos.X + boxW/2, headPos.Y)
    local BR = Vector2.new(rootPos.X + boxW/2, bottomPos.Y)
    local BL = Vector2.new(rootPos.X - boxW/2, bottomPos.Y)

    -- =========================================================
    -- BOX
    -- =========================================================
    if S.ESPEnabled.enabled and S.Box.enabled then
        reg.Box.Outline.Visible = true
        reg.Box.Outline.PointA, reg.Box.Outline.PointB = TL, TR
        reg.Box.Outline.PointC, reg.Box.Outline.PointD = BR, BL
        reg.Box.Main.Visible = true
        reg.Box.Main.PointA, reg.Box.Main.PointB = TL, TR
        reg.Box.Main.PointC, reg.Box.Main.PointD = BR, BL
        reg.Box.Main.Color = col
    else
        reg.Box.Outline.Visible = false
        reg.Box.Main.Visible = false
    end

    -- =========================================================
    -- BOX CORNER (стиль уголков)
    -- =========================================================
    if S.ESPEnabled.enabled and S.BoxCorner.enabled and S.Box.enabled then
        local L = S.BoxCorner.length
        local corners = {
            {TL, Vector2.new(TL.X + L, TL.Y)},
            {TL, Vector2.new(TL.X, TL.Y + L)},
            {TR, Vector2.new(TR.X - L, TR.Y)},
            {TR, Vector2.new(TR.X, TR.Y + L)},
            {BL, Vector2.new(BL.X + L, BL.Y)},
            {BL, Vector2.new(BL.X, BL.Y - L)},
            {BR, Vector2.new(BR.X - L, BR.Y)},
            {BR, Vector2.new(BR.X, BR.Y - L)}
        }
        for i, pair in ipairs(corners) do
            local line = reg.BoxCorner["L" .. i]
            if line then
                line.Visible = true
                line.From = pair[1]
                line.To = pair[2]
                line.Color = col
                line.Thickness = S.BoxCorner.thickness
            end
        end
    else
        for _, line in pairs(reg.BoxCorner) do line.Visible = false end
    end

    -- =========================================================
    -- TRACER
    -- =========================================================
    if S.ESPEnabled.enabled and S.Tracer.enabled then
        reg.Tracer.Visible = true
        reg.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
        reg.Tracer.To = Vector2.new(rootPos.X, bottomPos.Y)
        reg.Tracer.Color = col
    else reg.Tracer.Visible = false end

    -- =========================================================
    -- HEAD DOT
    -- =========================================================
    if S.ESPEnabled.enabled and S.HeadDot.enabled then
        reg.HeadDot.Circle.Visible = true
        reg.HeadDot.Circle.Position = Vector2.new(headPos.X, headPos.Y)
        reg.HeadDot.Circle.Color = col
    else reg.HeadDot.Circle.Visible = false end

    -- =========================================================
    -- NAME
    -- =========================================================
    if S.ESPEnabled.enabled and S.Name.enabled then
        reg.Name.Text.Visible = true
        reg.Name.Text.Position = Vector2.new(rootPos.X, headPos.Y - 20)
        reg.Name.Text.Text = player.Name
        reg.Name.Text.Color = col
    else reg.Name.Text.Visible = false end

    -- =========================================================
    -- DISTANCE
    -- =========================================================
    if S.ESPEnabled.enabled and S.Distance.enabled then
        reg.Distance.Text.Visible = true
        reg.Distance.Text.Position = Vector2.new(rootPos.X, bottomPos.Y + 4)
        reg.Distance.Text.Text = string.format("[%d]", math.floor(dist))
    else reg.Distance.Text.Visible = false end

    -- =========================================================
    -- HEALTH BAR
    -- =========================================================
    if S.ESPEnabled.enabled and S.Health.enabled then
        local hp = hum.Health / math.max(hum.MaxHealth, 1)
        local barX = rootPos.X + boxW/2 + 6
        reg.Health.Bg.Visible = true
        reg.Health.Bg.From = Vector2.new(barX, headPos.Y)
        reg.Health.Bg.To = Vector2.new(barX, bottomPos.Y)
        reg.Health.Fill.Visible = true
        reg.Health.Fill.From = Vector2.new(barX, headPos.Y)
        reg.Health.Fill.To = Vector2.new(barX, headPos.Y + boxH * hp)
        reg.Health.Fill.Color = Color3.fromRGB(255 * (1-hp), 255 * hp, 0)
    else
        reg.Health.Bg.Visible = false
        reg.Health.Fill.Visible = false
    end

    -- =========================================================
    -- SKELETON
    -- =========================================================
    local skelAny = S.Skeleton.enabled or S.SkeletonThick.enabled
        or S.SkeletonNeon.enabled or S.SkeletonRainbow.enabled
        or S.SkeletonPriority.enabled
    if S.ESPEnabled.enabled and skelAny then
        local thick, skelCol = 1, S.Skeleton.color
        if S.SkeletonThick.enabled then thick = S.SkeletonThick.thickness skelCol = S.SkeletonThick.color end
        if S.SkeletonNeon.enabled then thick = S.SkeletonNeon.thickness skelCol = S.SkeletonNeon.color end
        if S.SkeletonPriority.enabled then thick = S.SkeletonPriority.thickness skelCol = S.SkeletonPriority.color end
        if S.SkeletonRainbow.enabled then
            skelCol = Color3.fromHSV((tick() * S.SkeletonRainbow.speed) % 1, 1, 1)
        end

        for i, pair in ipairs(self.Bones) do
            local a = char:FindFirstChild(pair[1])
            local b = char:FindFirstChild(pair[2])
            local line = reg.Skeleton.Lines[i]
            if a and b and line then
                local ap, aOn = Camera:WorldToViewportPoint(a.Position)
                local bp, bOn = Camera:WorldToViewportPoint(b.Position)
                if aOn and bOn then
                    line.Visible = true
                    line.From = Vector2.new(ap.X, ap.Y)
                    line.To = Vector2.new(bp.X, bp.Y)
                    line.Color = skelCol
                    line.Thickness = thick
                else line.Visible = false end
            elseif line then line.Visible = false end
        end
    else
        for _, l in ipairs(reg.Skeleton.Lines) do l.Visible = false end
    end
end

