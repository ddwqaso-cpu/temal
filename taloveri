            Size = UDim2.new(0, 3, 0, 0),
            Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = PHANTOM.Config.AccentColor,
            BorderSizePixel = 0,
            Parent = btn
        })
        UI.Corner(indicator, 2)

        -- Контейнер контента
        local container = UI.New("ScrollingFrame", {
            Size = UDim2.new(1, -12, 1, -12),
            Position = UDim2.new(0, 6, 0, 6),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = PHANTOM.Config.AccentColor,
            ScrollBarImageTransparency = 0.3,
            Visible = false,
            Parent = content
        })
        local layout = UI.New("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = container
        })
        UI.Padding(container, 10)

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 24)
        end)

        local tabData = {
            Name = name,
            Icon = icon,
            Button = btn,
            Container = container,
            Indicator = indicator,
            Layout = layout
        }
        tabs[name] = tabData

        btn.MouseButton1Click:Connect(function() SelectTab(tabData) end)
        btn.MouseEnter:Connect(function()
            if currentTab ~= name then
                UI.Tween(btn, { BackgroundColor3 = PHANTOM.Config.ElementColor }, 0.1):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if currentTab ~= name then
                UI.Tween(btn, { BackgroundColor3 = PHANTOM.Config.PanelColor }, 0.1):Play()
            end
        end)

        if not currentTab then SelectTab(tabData) end

        return tabData
    end

    return {
        Main = main,
        ScreenGui = screenGui,
        Sidebar = sidebar,
        Content = content,
        CreateTab = CreateTab,
        Tabs = tabs
    }
end
