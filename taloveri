--// Centralized hook registry to prevent conflicts and allow clean unhooking
local HookRegistry = {
    namecall = { original = nil, hooked = nil, active = false },
    index = { original = nil, hooked = nil, active = false },
    newindex = { original = nil, hooked = nil, active = false }
}

--// Gets a writable metatable copy without corrupting originals
local function GetWritableMetaTable(instance)
    local ok, mt = pcall(getrawmetatable, instance)
    if not ok or not mt then
        return nil
    end
    local ok2, _ = pcall(setreadonly, mt, false)
    return mt
end

--// Creates a hook closure with executor verification
local function CreateHookClosure(fn)
    if newcclosure then
        return newcclosure(fn)
    end
    if hookfunction then
        -- Fallback: wrap with hookfunction guard
        local env = getfenv(fn)
        return setfenv(fn, env)()
    end
    return fn
end

--// Safe hookmetamethod wrapper with error handling
local function SafeHookMetaMethod(instance, method, hookFn)
    local ok, result = pcall(function()
        return hookmetamethod(instance, method, hookFn)
    end)
    if ok then
        return result
    end
    warn("[Phantom] hookmetamethod failed for " .. tostring(method) .. " — using fallback")
    return nil
end

--// Initializes the namecall hook for Silent Aim
local function InstallNameCallHook()
    if HookRegistry.namecall.active then return true end
    
    local mt = GetWritableMetaTable(game)
    if not mt then return false end
    
    local oldNameCall = mt.__namecall
    HookRegistry.namecall.original = oldNameCall
    
    local hookedNameCall = CreateHookClosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        --// Silent Aim interception
        if PHANTOM.Runtime.SilentAimActive and PHANTOM.Config.SilentAimEnabled then
            local target = PHANTOM.Aimbot.GetSilentTarget()
            
            if target and target.Character then
                local targetPart = target.Character:FindFirstChild(PHANTOM.Config.SilentAimPart or "Head")
                    or target.Character:FindFirstChild("HumanoidRootPart")
                
                if targetPart then
                    --// Intercept ray/position arguments in remote calls
                    if method == "FireServer" and typeof(args[1]) == "Vector3" then
                        local predictedPos = PHANTOM.Aimbot.CalculatePrediction(targetPart)
                        args[1] = predictedPos
                        return oldNameCall(self, unpack(args))
                    end
                    
                    if method == "FindPartOnRayWithIgnoreList" or method == "Raycast" then
                        local cameraPos = Camera.CFrame.Position
                        local direction = (targetPart.Position - cameraPos).Unit
                        local newRay = Ray.new(cameraPos, direction * 1000)
                        
                        --// Replace ray argument (index varies by method)
                        for i, v in ipairs(args) do
                            if typeof(v) == "Ray" then
                                args[i] = newRay
                                break
                            end
                        end
                        return oldNameCall(self, unpack(args))
                    end
                end
            end
        end
        
        return oldNameCall(self, ...)
    end)
    
    mt.__namecall = hookedNameCall
    setreadonly(mt, true)
    
    HookRegistry.namecall.hooked = hookedNameCall
    HookRegistry.namecall.active = true
    return true
end

