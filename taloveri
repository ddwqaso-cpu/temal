PHANTOM.Keybinds = {
    Registry = {},

    Register = function(self, name, defaultKey, callback, mode)
        self.Registry[name] = {
            Name = name,
            Key = defaultKey,
            Callback = callback,
            Mode = mode or "Toggle",  -- Toggle | Hold
            Active = false,
            LastPress = 0
        }
        return self.Registry[name]
    end,

    Unregister = function(self, name)
        self.Registry[name] = nil
    end,

    SetKey = function(self, name, keyCode)
        if self.Registry[name] then
            self.Registry[name].Key = keyCode
        end
    end,

    Get = function(self, name)
        return self.Registry[name]
    end,

    IsHeld = function(self, name)
        local bind = self.Registry[name]
        if not bind then return false end
        return Services.UserInputService:IsKeyDown(bind.Key)
    end,

    SetActive = function(self, name, state)
        local bind = self.Registry[name]
        if not bind then return end
        bind.Active = state
        if bind.Callback then pcall(bind.Callback, state) end
    end,

    Initialize = function(self)
        Services.UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            local now = tick()
            for _, bind in pairs(self.Registry) do
                local match = false
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == bind.Key then
                    match = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 and bind.Key == Enum.UserInputType.MouseButton1 then
                    match = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 and bind.Key == Enum.UserInputType.MouseButton2 then
                    match = true
                end

                if match and now - bind.LastPress > 0.15 then
                    bind.LastPress = now
                    if bind.Mode == "Toggle" then
                        bind.Active = not bind.Active
                    else
                        bind.Active = true
                    end
                    if bind.Callback then pcall(bind.Callback, bind.Active) end
                end
            end
        end)

        Services.UserInputService.InputEnded:Connect(function(input, gp)
            if gp then return end
            for _, bind in pairs(self.Registry) do
                if bind.Mode ~= "Hold" then continue end
                local match = false
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == bind.Key then
                    match = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 and bind.Key == Enum.UserInputType.MouseButton1 then
                    match = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 and bind.Key == Enum.UserInputType.MouseButton2 then
                    match = true
                end
                if match then
                    bind.Active = false
                    if bind.Callback then pcall(bind.Callback, false) end
                end
            end
        end)
    end
}

--=====================================================================
-- SECTION: METATABLE HOOK SYSTEM
--=====================================================================

PHANTOM.Hooks = {
    Registry = {
        namecall = { original = nil, hooked = nil, active = false },
        index    = { original = nil, hooked = nil, active = false }
    },

    GetWritableMetaTable = function(self, instance)
        local ok, mt = pcall(getrawmetatable, instance)
        if not ok or not mt then return nil end
        pcall(setreadonly, mt, false)
        return mt
    end,

    CreateClosure = function(self, fn)
        if newcclosure then return newcclosure(fn) end
        return fn
    end,

    -- =========================================================
    -- NAMECALL (для Silent Aim)
    -- =========================================================
    InstallNameCall = function(self)
        if self.Registry.namecall.active then return true end
        local mt = self:GetWritableMetaTable(game)
        if not mt then return false end

        local oldNameCall = mt.__namecall
        self.Registry.namecall.original = oldNameCall

        local hooked = self:CreateClosure(function(self_, ...)
            local method = getnamecallmethod()
            local args = {...}

            if PHANTOM.Runtime.SilentAimActive and PHANTOM.Config.SilentAimEnabled then
                local target = PHANTOM.Aimbot:GetSilentTarget()
                if target and target.Character then
                    local tp = target.Character:FindFirstChild(PHANTOM.Config.SilentAimPart)
                        or target.Character:FindFirstChild("Head")
                        or target.Character:FindFirstChild("HumanoidRootPart")

                    if tp then
                        -- Перехват аргументов-векторов (для remotes стрельбы)
                        if method == "FireServer" then
                            for i, arg in ipairs(args) do
                                if typeof(arg) == "Vector3" then
                                    args[i] = PHANTOM.Aimbot:CalculatePrediction(tp)
                                    break
                                end
                            end
                            return oldNameCall(self_, unpack(args))
                        end

                        -- Перехват Raycast
                        if method == "FindPartOnRayWithIgnoreList" or method == "Raycast" then
                            local camPos = Camera.CFrame.Position
                            local dir = (tp.Position - camPos).Unit
                            for i, arg in ipairs(args) do
                                if typeof(arg) == "Ray" then
                                    args[i] = Ray.new(camPos, dir * 1000)
                                    break
                                end
                            end
                            return oldNameCall(self_, unpack(args))
                        end
                    end
                end
            end

            return oldNameCall(self_, ...)
        end)

        mt.__namecall = hooked
        setreadonly(mt, true)
        self.Registry.namecall.hooked = hooked
        self.Registry.namecall.active = true
        return true
    end,

    -- =========================================================
    -- INDEX (перехват чтения свойств)
    -- =========================================================
    InstallIndex = function(self, instance, property, hookFn)
        local mt = self:GetWritableMetaTable(instance)
        if not mt then return false end
        local oldIndex = mt.__index
        local hooked = self:CreateClosure(function(self_, key)
            if key == property then
                return hookFn(oldIndex(self_, key))
            end
            return oldIndex(self_, key)
        end)
        mt.__index = hooked
        setreadonly(mt, true)
        return true
    end,

    UninstallAll = function(self)
        local mt = self:GetWritableMetaTable(game)
        if mt and self.Registry.namecall.original then
            mt.__namecall = self.Registry.namecall.original
            self.Registry.namecall.active = false
        end
        if mt then setreadonly(mt, true) end
    end
}
