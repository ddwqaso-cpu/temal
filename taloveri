function PHANTOM.SetMenuOpacity(value)
    -- value = 0..100, где 100 = полностью видимое, 0 = почти невидимое
    local alpha = 1 - (value / 100)  -- 0 = opaque, 0.95 = почти invisible
    PHANTOM.Config.MenuOpacity = value

    if not PHANTOM.UI.Main then return end

    for _, desc in ipairs(PHANTOM.UI.Main:GetDescendants()) do
        if desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("TextBox") or desc:IsA("ScrollingFrame") then
            -- Пропускаем акценты и иконки
            local skip = false
            if desc.BackgroundColor3 == PHANTOM.Config.AccentColor then skip = true end
            if desc.BackgroundColor3 == Color3.fromRGB(88, 101, 242) then skip = true end  -- Discord
            if desc.Name == "ResizeGrip" then skip = true end

            if not skip and desc.BackgroundTransparency ~= 1 then
                desc.BackgroundTransparency = U.Clamp(alpha * 0.9, 0, 0.95)
            end
        end

        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            if desc.TextTransparency ~= 1 and desc.Text ~= "" then
                desc.TextTransparency = U.Clamp(alpha * 0.15, 0, 0.6)
            end
        end

        if desc:IsA("UIStroke") then
            desc.Transparency = U.Clamp(alpha * 0.8, desc.Transparency, 1)
        end
    end
end
