PHANTOM.Player = {
    Features = {
        SpeedHack    = { enabled = false, value = 16 },
        JumpPower    = { enabled = false, value = 50 },
        Noclip       = { enabled = false },
        Fly          = { enabled = false, speed = 50 },
        InfiniteJump = { enabled = false, lastJump = 0 }
    },

    Update = function(self)
        local char, hum, root = U.GetLocalCharacter()
        if not char then return end

        if hum then
            if self.Features.SpeedHack.enabled then hum.WalkSpeed = self.Features.SpeedHack.value end
            if self.Features.JumpPower.enabled then
                hum.UseJumpPower = true
                hum.JumpPower = self.Features.JumpPower.value
            end
            if self.Features.InfiniteJump.enabled and tick() - self.Features.InfiniteJump.lastJump > 0.1 then
                if Services.UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    hum.Jump = true
                    self.Features.InfiniteJump.lastJump = tick()
                end
            end
        end

        if self.Features.Noclip.enabled then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end

        if self.Features.Fly.enabled and root then
            local dir = Vector3.new()
            local UIS = Services.UserInputService
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
            root.AssemblyLinearVelocity = dir.Magnitude > 0
                and dir.Unit * self.Features.Fly.speed
                or Vector3.new(0,0,0)
        end
    end
}

