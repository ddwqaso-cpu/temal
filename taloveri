PHANTOM.Keybinds = {
    Registry = {},

    Register = function(self, name, defaultKey, callback, mode)
        self.Registry[name] = {
            Name = name,
            Key = defaultKey,
            Callback = callback,
            Mode = mode or "Toggle",
            Active = false,
            LastPress = 0
        }
        return self.Registry[name]
    end,

    Unregister = function(self, name)
        self.Registry[name] = nil
    end,

    SetKey = function(self, name, keyCode)
        if self.Registry[name] then
            self.Registry[name].Key = keyCode
        end
    end,

    Get = function(self, name)
        return self.Registry[name]
    end,

    IsHeld = function(self, name)
        local bind = self.Registry[name]
        if not bind then return false end
        return Services.UserInputService:IsKeyDown(bind.Key)
    end,

    SetActive = function(self, name, state)
        local bind = self.Registry[name]
        if not bind then return end
        bind.Active = state
        if bind.Callback then
            pcall(bind.Callback, state)
        end
    end,

    Initialize = function(self)
        Services.UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard
               and input.UserInputType ~= Enum.UserInputType.MouseButton1
               and input.UserInputType ~= Enum.UserInputType.MouseButton2 then
                return
            end

            local now = tick()
            for _, bind in pairs(self.Registry) do
                local matches = false
                if input.UserInputType == Enum.UserInputType.Keyboard
                   and input.KeyCode == bind.Key then
                    matches = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton1
                   and bind.Key == Enum.UserInputType.MouseButton1 then
                    matches = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton2
                   and bind.Key == Enum.UserInputType.MouseButton2 then
                    matches = true
                end

                if matches and now - bind.LastPress > 0.15 then
                    bind.LastPress = now
                    if bind.Mode == "Toggle" then
                        bind.Active = not bind.Active
                    elseif bind.Mode == "Hold" then
                        bind.Active = true
                    end
                    if bind.Callback then
                        pcall(bind.Callback, bind.Active)
                    end
                end
            end
        end)

        Services.UserInputService.InputEnded:Connect(function(input, gp)
            if gp then return end
            for _, bind in pairs(self.Registry) do
                if bind.Mode ~= "Hold" then continue end
                local matches = false
                if input.UserInputType == Enum.UserInputType.Keyboard
                   and input.KeyCode == bind.Key then
                    matches = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton1
                   and bind.Key == Enum.UserInputType.MouseButton1 then
                    matches = true
                elseif input.UserInputType == Enum.UserInputType.MouseButton2
                   and bind.Key == Enum.UserInputType.MouseButton2 then
                    matches = true
                end

                if matches then
                    bind.Active = false
                    if bind.Callback then
                        pcall(bind.Callback, false)
                    end
                end
            end
        end)
    end
}

