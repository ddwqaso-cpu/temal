-- SECTION: RENDER LOOP
--=====================================================================

function PHANTOM.StartRenderLoop()
    PHANTOM.Runtime.Connections.Render = Services.RunService.RenderStepped:Connect(function(dt)
        -- Aimbot
        pcall(function() PHANTOM.Aimbot:RunVectorAim() end)

        -- Visuals
        pcall(function() PHANTOM.Visuals:RenderLoop() end)

        -- Combat
        pcall(function() PHANTOM.Combat:Update() end)

        -- Movement
        pcall(function() PHANTOM.Movement:Update() end)

        -- Misc
        pcall(function() PHANTOM.Misc:Update() end)
    end)
end

--=====================================================================
-- SECTION: UNLOAD
--=====================================================================

function PHANTOM.Unload()
    PHANTOM.DisconnectAll()

    pcall(function() PHANTOM.Visuals:Cleanup() end)
    pcall(function() PHANTOM.Hooks:UninstallAll() end)

    if PHANTOM.UI.ScreenGui then
        pcall(function() PHANTOM.UI.ScreenGui:Destroy() end)
    end

    for _, gui in ipairs(Services.CoreGui:GetChildren()) do
        if gui.Name == "PhantomToast" then
            pcall(function() gui:Destroy() end)
        end
    end

    -- Сброс состояний
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = true
                p.Anchored = false
            end
        end
    end

    Services.Workspace.Gravity = 196.2
    pcall(function() settings().Rendering.QualityLevel = 10 end)

    PHANTOM.Runtime.Initialized = false
    PHANTOM.ShowToast("PHANTOM", "Скрипт выгружен", 3)
end

