    sub.Font = Enum.Font.Gotham
    sub.TextSize = 12
    sub.TextXAlignment = Enum.TextXAlignment.Left
    sub.Parent = sub

    frame.BackgroundTransparency = 1
    title.TextTransparency = 1
    sub.TextTransparency = 1
    icon.ImageTransparency = 1
    stroke.Transparency = 1

    local TS = Services.TweenService
    local t1 = TS:Create(frame, TweenInfo.new(0.25), {BackgroundTransparency = 0})
    local t2 = TS:Create(title, TweenInfo.new(0.25), {TextTransparency = 0})
    local t3 = TS:Create(sub, TweenInfo.new(0.25), {TextTransparency = 0})
    local t4 = TS:Create(icon, TweenInfo.new(0.25), {ImageTransparency = 0})
    local t5 = TS:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.4})
    t1:Play() t2:Play() t3:Play() t4:Play() t5:Play()

