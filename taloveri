        local o1 = TS:Create(frame, TweenInfo.new(0.35), {BackgroundTransparency = 1})
        local o2 = TS:Create(title, TweenInfo.new(0.35), {TextTransparency = 1})
        local o3 = TS:Create(sub, TweenInfo.new(0.35), {TextTransparency = 1})
        local o4 = TS:Create(icon, TweenInfo.new(0.35), {ImageTransparency = 1})
        local o5 = TS:Create(stroke, TweenInfo.new(0.35), {Transparency = 1})
        o1:Play() o2:Play() o3:Play() o4:Play() o5:Play()
        task.wait(0.4)
        pcall(function() sg:Destroy() end)
    end)
