local ColorUtil = {}

function ColorUtil.FromHSV(h, s, v)
    return Color3.fromHSV(h, s, v)
end

function ColorUtil.Rainbow(speed, offset)
    local t = (tick() * (speed or 1)) + (offset or 0)
    return Color3.fromHSV(t % 1, 1, 1)
end

function ColorUtil.ToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255),
        math.floor(c.G * 255),
        math.floor(c.B * 255))
end

function ColorUtil.Lerp(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

function ColorUtil.WithAlpha(c, a)
    return Color3.new(c.R * a, c.G * a, c.B * a)
end

PHANTOM.ColorUtil = ColorUtil

