function PHANTOM.SetMenuOpacity(value)
    -- value 0..100
    local alpha = 1 - (value / 100)
    PHANTOM.Config.MenuOpacity = value

    if not PHANTOM.UI.Main then return end

    for _, desc in ipairs(PHANTOM.UI.Main:GetDescendants()) do
        if desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            -- Пропускаем чекбоксы/кнопки-акценты
            if desc.BackgroundColor3 == PHANTOM.Config.AccentColor then continue end
            if desc.BackgroundTransparency ~= 1 then
                desc.BackgroundTransparency = alpha * 0.85
            end
        end
        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            if desc.TextTransparency ~= 1 then
                desc.TextTransparency = alpha * 0.3
            end
        end
    end
end
